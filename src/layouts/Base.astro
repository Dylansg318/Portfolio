---
import { Font } from 'astro:assets';
import { site } from '../lib/site';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image URL. Falls back to the generated one. */
  ogImage?: string;
  /** Hide site chrome — used by the fullscreen /play routes. */
  bare?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage,
  bare = false,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
// `build.format: 'file'` means Astro.url.pathname is the OUTPUT FILENAME
// (/about.html), not the URL a visitor uses (/about). Canonical and og:url
// must be the served address or search engines index a URL that is not the
// one people land on.
const canonicalPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '');
const canonical = new URL(canonicalPath || '/', Astro.site);
const ogUrl = ogImage ? new URL(ogImage, Astro.site) : new URL('/og/default.png', Astro.site);

// Structured data so a recruiter's search — or an AI assistant's — resolves
// this page to a person with a job title, not an anonymous website.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Software Engineer',
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Chantilly', addressRegion: 'VA' },
  worksFor: { '@type': 'Organization', name: 'RMH3 Dental Supply' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'George Mason University' },
    { '@type': 'EducationalOrganization', name: 'CYDEO' },
  ],
  sameAs: [site.links.github, site.links.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#071c27" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- Set the theme before first paint. Inline and blocking on purpose:
         deferring this is what causes the white flash on a dark-mode reload.
         Dark is the default; a visitor's explicit toggle wins over it. -->
    <script is:inline>
      (() => {
        // `js` gates the scroll-reveal hidden state: no JS, nothing hides.
        const root = document.documentElement;
        root.classList.add('js');
        try {
          // A ?skin= or ?mode= param wins and persists — that is what makes
          // shareable A/B links work. Otherwise the stored choice applies.
          const params = new URLSearchParams(location.search);

          const stored = localStorage.getItem('theme');
          root.dataset.theme = stored === 'light' ? 'light' : 'dark';

          // The old "packing slip" skin grew up into Help Desk mode at /desk.
          // Shared ?skin=slip A/B links keep working by redirecting there.
          if (params.get('skin') === 'slip' && location.pathname !== '/desk') {
            localStorage.removeItem('skin');
            location.replace('/desk');
          }

          const modeParam = params.get('mode');
          if (modeParam === 'eng' || modeParam === 'plain') {
            localStorage.setItem('mode', modeParam);
          }
          root.dataset.mode = localStorage.getItem('mode') === 'eng' ? 'eng' : 'plain';
        } catch {
          /* private mode / blocked storage — dark Meadow, plain English */
        }
      })();
    </script>

    <!-- Cloudflare Web Analytics: free, cookie-less, no consent banner needed.
         Paste the token from the Cloudflare dashboard to switch it on.
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js'
            data-cf-beacon='{"token": "YOUR_TOKEN"}'></script>
    -->
  </head>

  <body class="min-h-dvh flex flex-col bg-bg text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      Skip to content
    </a>

    {!bare && <Header />}

    <main id="main" class="flex-1">
      <slot />
    </main>

    {!bare && <Footer />}

    <!-- One observer for every .reveal on the page, PLUS a scroll-position
         sweep as a safety net: if the observer ever misses (fast programmatic
         scrolling, browser quirks), anything at or above the viewport gets
         revealed anyway. Content staying invisible is the one failure this
         effect is never allowed to have. -->
    <script>
      const els = [...document.querySelectorAll<HTMLElement>('.reveal')];
      if (els.length > 0 && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));

        let pending = els;
        let timer = 0;
        const sweep = () => {
          pending = pending.filter((el) => {
            if (el.classList.contains('is-in')) return false;
            // display:none (a mode-hidden variant) has no geometry — leave it
            // pending; the mode toggle reveals everything when it flips.
            if (el.getClientRects().length === 0) return true;
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight || r.bottom < 0) {
              el.classList.add('is-in');
              io.unobserve(el);
              return false;
            }
            return true;
          });
          if (pending.length === 0) window.removeEventListener('scroll', onScroll);
        };
        const onScroll = () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(sweep, 150);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        sweep();
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
