---
import { site } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-(--container-wide) items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="font-semibold tracking-tight text-ink transition-colors hover:text-accent"
    >
      {site.name}
    </a>

    <!-- Only three links, so they stay visible on mobile. A hamburger menu for
         three items is a tap the user shouldn't have to make. -->
    <nav class="ml-auto flex items-center gap-1 sm:gap-2" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-2.5 py-1.5 text-sm transition-colors sm:px-3',
              isActive(item.href)
                ? 'bg-surface-raised font-medium text-ink'
                : 'text-ink-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>
