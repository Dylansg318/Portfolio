---
import { site } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="sticky top-0 z-40 bg-nav text-nav-ink">
  <div class="mx-auto flex h-16 max-w-(--container-wide) items-center gap-3 px-4 sm:gap-4 sm:px-6">
    <a
      href="/"
      class="font-semibold tracking-tight text-nav-ink transition-opacity hover:opacity-80"
    >
      {site.shortName}
    </a>

    <!-- Three links, so they stay visible on mobile. A hamburger for three
         items is a tap the visitor should not have to make. -->
    <nav class="ml-auto flex items-center gap-1" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-2.5 py-1.5 text-sm transition-colors sm:px-3',
              isActive(item.href)
                ? 'bg-tab-active font-semibold text-tab-active-ink'
                : 'text-nav-muted hover:text-nav-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>
