---
import { site } from '../../lib/site';
import { endpoint } from '../../lib/endpoints';

// The tabs, Contact and the API reference are pages the endpoint list names,
// so the header, GET /api and /reference can't disagree about what a page is
// called. Home is the name.
const tabs = ['work', 'projects', 'experience', 'resume'].map((k) => endpoint(k).page);
const contact = endpoint('contact').page;
const reference = endpoint('index').page;
// `build.format: 'file'` makes the pathname the output file: /work.html,
// /work/internal-erp.html. A tab is current on its page and everything under it.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '');
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
---
<!-- The site's one navigation, the way an API's docs do it: the name, the
     sections as tabs, then the API reference and the controls. Below 1024px
     the tabs drop to a strip under the bar; under 640px Contact joins them.
     Inside Work and Projects a side menu lists the tab's pages
     (SideMenu.astro). It replaced the endpoint rail on 2026-10-22. -->
<header class="site-head sticky top-0 z-40 border-b border-border bg-nav text-nav-ink">
  <div class="in">
    <a href="/" class="name" aria-label={`${site.name} — home`}>
      <span class="long">{site.name}</span><span class="short">{site.shortName}</span>
    </a>

    <nav class="tabs" aria-label="Site">
      {tabs.map((t) => <a href={t.href} aria-current={current(t.href)}>{t.label}</a>)}
      <a href={contact.href} class="tab-contact" aria-current={current(contact.href)}>{contact.label}</a>
    </nav>

    <div class="right">
      <a href={reference.href} class="api" aria-current={current(reference.href)} title={reference.label}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1" /></svg>
        <span class="lbl">{reference.label}</span>
      </a>

      <!-- Plain English ⇄ Engineer: the same pages, two registers. Default is
           plain; the choice sticks. On the reference pages both registers are
           already on screen (prose left, response right); the switch decides
           which one the prose column speaks. -->
      <div class="seg" role="group" aria-label="Reading mode">
        <button type="button" data-mode-btn="plain">
          <span class="long">Plain English</span><span class="short">Plain</span>
        </button>
        <button type="button" data-mode-btn="eng">
          <span class="long">Engineer</span><span class="short">Tech</span>
        </button>
      </div>

      <!-- Light ⇄ dark. The choice sticks; with nothing stored the OS
           preference applies (resolved before first paint in Base.astro).
           The label says what pressing it does, not what it is. -->
      <button type="button" class="theme" id="theme-btn" aria-label="Switch to dark mode">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <a href={contact.href} class="cta" aria-current={current(contact.href)}>{contact.label}</a>
    </div>
  </div>
</header>

<!-- First-visit hint for the reading-mode switch. It looks like any other
     control, so most visitors never learn the site has two registers. Shown
     once, dismissed by the button or by using the switch, remembered in
     localStorage. Hidden by default so a no-JS visitor and a returning one
     see nothing. -->
<div id="mode-hint" hidden class="no-print border-b border-border bg-surface-raised text-sm text-ink-muted">
  <div class="mx-auto flex max-w-(--container-wide) flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-2.5 sm:px-8">
    <p>
      Two ways to read this site: <strong class="font-semibold text-ink">Plain English</strong> for
      what the work did, <strong class="font-semibold text-ink">Engineer</strong> for how. The switch is in the top bar.
    </p>
    <button type="button" id="mode-hint-dismiss" class="btn btn-ghost !px-3 !py-1 text-xs">Got it</button>
  </div>
</div>

<style>
  /* One row from 1024px: name, tabs, then the right-hand controls. Below it
     the tabs wrap to a second row of their own, the strip. Five short words
     fit a 360px phone, so it never needs to scroll, and nothing on it is
     faded out; it still can scroll if a label grows. --head-h is the two
     rows together. */
  .in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1rem;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) { .in { padding-inline: 2rem; } }
  .name { font-size: 0.9375rem; font-weight: 600; color: var(--nav-ink); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; }
  .name:hover { color: var(--accent); }
  .right { order: 1; margin-left: auto; display: flex; align-items: center; gap: 0.75rem; height: var(--bar-h); }
  @media (min-width: 640px) { .right { gap: 1rem; } }
  .tabs {
    order: 2;
    /* full bleed: the bar's padding back on both sides */
    flex-basis: calc(100% + 2.5rem);
    display: flex;
    gap: 0.25rem;
    height: var(--strip-h);
    margin-inline: -1.25rem;
    padding-inline: 0.75rem;
    border-top: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  @media (min-width: 640px) { .tabs { flex-basis: calc(100% + 4rem); margin-inline: -2rem; padding-inline: 1.5rem; } }
  .tabs a {
    display: inline-flex;
    align-items: center;
    padding-inline: 0.4rem;
    border-bottom: 2px solid transparent;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }
  /* The bar has room for Contact from 640px; under it, Contact is a tab. */
  @media (min-width: 640px) { .tab-contact { display: none !important; } }
  @media (min-width: 1024px) {
    .in { flex-wrap: nowrap; column-gap: 1.75rem; height: var(--bar-h); }
    .tabs {
      order: 0;
      flex-basis: auto;
      align-self: stretch;
      height: auto;
      margin: 0;
      padding: 0;
      border-top: 0;
      overflow: visible;
    }
    .tabs a { padding-inline: 0.6rem; font-size: 0.9375rem; }
  }
  .api {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .api:hover, .api[aria-current='page'] { color: var(--accent); }
  .api svg { width: 1rem; height: 1rem; }
  /* The label shows where the bar has room for it; the icon keeps its name. */
  @media (max-width: 1279px) {
    .api .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (max-width: 639px) { .api { display: none; } }
  .seg {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .seg button {
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    color: var(--ink-muted);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .seg button[aria-pressed='true'] { background: var(--tab-active); color: var(--tab-active-ink); font-weight: 600; }
  .short { display: none; }
  .theme {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--ink-muted);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .theme:hover { color: var(--ink); border-color: var(--border-strong); background: var(--surface-raised); }
  .theme svg { width: 1rem; height: 1rem; }
  /* The icon is the one you would get by pressing: a moon in light, a sun in dark. */
  .theme .sun { display: none; }
  :global(html[data-theme='dark']) .theme .sun { display: block; }
  :global(html[data-theme='dark']) .theme .moon { display: none; }
  .cta {
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    background: var(--accent-fill);
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur) var(--ease);
  }
  .cta:hover { background: var(--accent-fill-hover); }
  @media (max-width: 639px) {
    .long { display: none; }
    .short { display: inline; }
    .cta { display: none; }
  }
</style>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    const root = document.documentElement;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');

    const paint = () => {
      const mode = root.dataset.mode === 'eng' ? 'eng' : 'plain';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === mode)));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.modeBtn === 'eng' ? 'eng' : 'plain';
        root.dataset.mode = mode;
        try {
          localStorage.setItem('mode', mode);
        } catch {
          /* storage blocked — still flips for this page view */
        }
        // Copy hidden by the previous mode was display:none, so the scroll
        // observer never revealed it. Reveal everything on flip or the newly
        // shown variant sits at opacity 0 forever.
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
        paint();
      }),
    );

    paint();

    // The theme toggle. Base.astro resolved the starting theme before paint;
    // this flips it, stores it, and keeps the browser chrome's colour in step
    // (the two hex values are the token block's --bg).
    const themeBtn = document.getElementById('theme-btn');
    const paintTheme = () => {
      const dark = root.dataset.theme === 'dark';
      themeBtn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0d1117' : '#ffffff');
    };
    themeBtn?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked — still flips for this page view */
      }
      paintTheme();
    });
    paintTheme();

    // The one-time hint. Any interaction with the switch counts as having seen it.
    const hint = document.getElementById('mode-hint');
    const seen = () => {
      try { return localStorage.getItem('modeHintSeen') === '1'; } catch { return true; }
    };
    const dismiss = () => {
      if (hint) hint.hidden = true;
      try { localStorage.setItem('modeHintSeen', '1'); } catch { /* fine */ }
    };
    if (hint && !seen()) hint.hidden = false;
    document.getElementById('mode-hint-dismiss')?.addEventListener('click', dismiss);
    buttons.forEach((b) => b.addEventListener('click', dismiss));
  });
</script>
