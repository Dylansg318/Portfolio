---
import { site } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '/index' : path.startsWith(href);
---
<header
  class="sticky top-0 z-40 border-b border-white/10 bg-nav/90 text-nav-ink backdrop-blur-md supports-[backdrop-filter]:bg-nav/80"
>
  <div class="mx-auto flex h-16 max-w-(--container-wide) items-center gap-3 px-4 sm:gap-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 font-semibold tracking-tight text-nav-ink transition-opacity hover:opacity-80"
    >
      <span
        class="grid size-8 place-items-center rounded-lg bg-tab-active font-display text-sm font-bold text-tab-active-ink"
        aria-hidden="true"
      >
        D
      </span>
      <span class="hidden sm:inline">{site.name}</span>
      <span class="sm:hidden">{site.shortName}</span>
    </a>

    <!-- Four short links, so they stay visible on mobile. A hamburger for four
         items is a tap the visitor should not have to make. -->
    <nav class="ml-auto flex items-center gap-0.5 sm:gap-1" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-2 py-1.5 text-sm transition-colors sm:px-3',
              isActive(item.href)
                ? 'bg-tab-active font-semibold text-tab-active-ink'
                : 'text-nav-muted hover:bg-white/10 hover:text-nav-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/contact"
      class="hidden rounded-lg border border-white/20 px-3 py-1.5 text-sm font-medium text-nav-ink transition-colors hover:border-white/40 hover:bg-white/10 md:inline-flex"
    >
      Get in touch
    </a>

    <ThemeToggle />
  </div>
</header>
