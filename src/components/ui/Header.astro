---
import { site } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '/index' : path.startsWith(href);
---
<!-- Opacity is deliberately high: --nav is near-black, and at /80 the light
     theme composited it up to a mid-slate where the inactive nav labels landed
     at 4.82:1 — passing, but below what the contrast gate reports, since the
     gate scores the opaque token (8.93:1). At /90 the rendered bar scores
     6.71:1, so the gate is no longer the looser number. -->
<header
  class="sticky top-0 z-40 border-b border-white/10 bg-nav/95 text-nav-ink backdrop-blur-md supports-[backdrop-filter]:bg-nav/90"
>
  <div class="mx-auto flex h-16 max-w-(--container-wide) items-center gap-1.5 px-3 md:gap-4 md:px-6">
    <!-- No wordmark. The home page opens with the name at full size, so a
         second copy of it in the bar was the same fact twice — and "Home" is
         already in the nav, which is what the wordmark was for. -->

    <!-- Four short links, so they stay visible on mobile. A hamburger for four
         items is a tap the visitor should not have to make. -->
    <nav class="mr-auto flex items-center gap-0.5 md:gap-1" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-1 py-1.5 text-xs transition-colors md:px-3 md:text-sm',
              isActive(item.href)
                ? 'bg-tab-active font-semibold text-tab-active-ink'
                : 'text-nav-muted hover:bg-white/10 hover:text-nav-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Plain English ⇄ Engineer: the same pages, two registers. Default is
         plain; the choice sticks. -->
    <div
      class="flex shrink-0 items-center rounded-lg border border-white/20 p-0.5 text-[0.6875rem] font-medium md:text-xs"
      role="group"
      aria-label="Reading mode"
    >
      <button
        type="button"
        data-mode-btn="plain"
        class="rounded-md px-1 py-1 text-nav-muted transition-colors md:px-2.5"
      >
        <span class="hidden md:inline">Plain English</span><span class="md:hidden">Plain</span>
      </button>
      <button
        type="button"
        data-mode-btn="eng"
        class="rounded-md px-1 py-1 text-nav-muted transition-colors md:px-2.5"
      >
        <span class="hidden md:inline">Engineer</span><span class="md:hidden">Tech</span>
      </button>
    </div>

    <a
      href="/contact"
      class="hidden rounded-lg border border-white/20 px-3 py-1.5 text-sm font-medium text-nav-ink transition-colors hover:border-white/40 hover:bg-white/10 lg:inline-flex"
    >
      Get in touch
    </a>

    <ThemeToggle />
  </div>
</header>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
    const ACTIVE = ['bg-tab-active', 'text-tab-active-ink', 'font-semibold'];

    const paint = () => {
      const mode = document.documentElement.dataset.mode === 'eng' ? 'eng' : 'plain';
      buttons.forEach((b) => {
        const on = b.dataset.modeBtn === mode;
        b.classList.toggle('text-nav-muted', !on);
        ACTIVE.forEach((c) => b.classList.toggle(c, on));
        b.setAttribute('aria-pressed', String(on));
      });
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.modeBtn === 'eng' ? 'eng' : 'plain';
        document.documentElement.dataset.mode = mode;
        try {
          localStorage.setItem('mode', mode);
        } catch {
          /* storage blocked — still flips for this page view */
        }
        // Copy hidden by the previous mode was display:none, so the scroll
        // observer never revealed it. Reveal everything on flip or the newly
        // shown variant sits at opacity 0 forever.
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
        paint();
      }),
    );

    paint();
  });
</script>
