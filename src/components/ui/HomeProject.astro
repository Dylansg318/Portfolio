---
import Cover from './Cover.astro';
import { statusLabel, type Project } from '../../lib/content';

interface Props {
  project: Project;
  label: string;
  focus: string;
  number: number;
}
const { project: { data, id }, label, focus, number } = Astro.props;
---
<article class="reveal group flex flex-col">
  <div class="mb-4 flex items-center justify-between border-t border-border-strong pt-3 text-xs text-ink-faint">
    <p>{label}</p>
    <span class="font-mono" aria-hidden="true">0{number}</span>
  </div>
  <a href={`/projects/${id}`} class="block" aria-label={`Read ${data.title}`}>
    {data.cover ? (
      <div class="flex aspect-[4/3] items-center overflow-hidden rounded-lg border border-border bg-surface-raised p-3">
        <Cover cover={data.cover} coverDark={data.coverDark} alt={data.coverAlt ?? ''}
          class="max-h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
          widths={[400, 800]} sizes="(max-width: 767px) 100vw, 360px" />
      </div>
    ) : (
      <div class="flex aspect-[4/3] flex-col justify-center rounded-lg border border-border bg-surface p-6 sm:p-8">
        <p class="font-mono text-xs text-ink-faint">The workflow</p>
        <ol class="mt-4 space-y-3 text-sm">
          {['Define the rules', 'Build with agents', 'Review the consequences'].map((step, i) => (
            <li class="flex items-center gap-3">
              <span class="font-mono text-xs text-accent">0{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    )}
  </a>
  <p class="mt-5 text-xs text-ink-faint">{statusLabel[data.status]} · {data.date.getFullYear()}</p>
  <h3 class="mt-2 text-xl font-semibold leading-snug">
    <a href={`/projects/${id}`} class="hover:text-accent">{data.title}</a>
  </h3>
  <p class="mt-3 text-sm font-medium text-ink">{focus}</p>
  <p class="only-plain mt-2 text-sm leading-relaxed text-ink-muted">{data.plainBlurb ?? data.blurb}</p>
  <p class="only-eng mt-2 text-sm leading-relaxed text-ink-muted">{data.blurb}</p>
  <a href={`/projects/${id}`} class="mt-auto pt-5 text-sm font-medium text-accent hover:underline">Read the project →</a>
</article>
