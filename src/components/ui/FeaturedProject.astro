---
import Cover from './Cover.astro';
import { coverGradient, statusLabel, type Project } from '../../lib/content';

/** The flagship card on the home page: one project, full width, metrics
 *  visible without a click. */
interface Props { project: Project }
const { project } = Astro.props;
const { data, id } = project;
/** Shown in the generated cover when there is no screenshot yet. The
 *  placeholder used to print the project TITLE in large type, directly above
 *  the heading that prints it again; the headline number says something the
 *  title does not, so the card carries two facts instead of one fact twice. */
const headline = data.metrics[0];
/** The cover already shows the first metric when it is standing in for a
 *  screenshot, so the row below skips it rather than printing it twice. */
const inlineMetrics = data.cover ? data.metrics.slice(0, 4) : data.metrics.slice(1, 4);
---
<article class="tile reveal group grid overflow-hidden md:grid-cols-[1.1fr_1fr]">
  <div class="relative min-h-56 overflow-hidden bg-surface-raised md:min-h-full">
    {data.cover ? (
      <Cover
        cover={data.cover}
        coverDark={data.coverDark}
        alt={data.coverAlt ?? ''}
        class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        widths={[640, 1024]}
        sizes="(max-width: 768px) 100vw, 640px"
      />
    ) : (
      <div class="cover-art size-full" style={`background: ${coverGradient(id)}`}>
        <div class="absolute inset-0 flex flex-col justify-end p-8">
          {headline && (
            <>
              <p class="font-display text-6xl font-extrabold leading-none text-white drop-shadow sm:text-7xl">
                {headline.value}
              </p>
              <p class="mt-2 text-sm font-medium uppercase tracking-[0.14em] text-white/85">
                {headline.label}
              </p>
            </>
          )}
        </div>
      </div>
    )}
    <span class="absolute left-4 top-4 rounded-full bg-black/40 px-2.5 py-1 text-xs font-medium text-white backdrop-blur">
      Featured
    </span>
  </div>

  <div class="flex flex-col p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2 text-xs text-ink-faint">
      <span
        class:list={[
          'rounded-full px-2 py-0.5 font-medium',
          data.status === 'live' && 'bg-ok/15 text-ok',
          data.status === 'wip' && 'bg-warn/15 text-warn',
          data.status === 'archived' && 'bg-ink-faint/15 text-ink-muted',
        ]}
      >
        {statusLabel[data.status]}
      </span>
      {data.role && <span>· {data.role}</span>}
      <time datetime={data.date.toISOString()}>
        · {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
      </time>
    </div>

    <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      <a href={`/projects/${id}`} class="after:absolute after:inset-0">{data.title}</a>
    </h3>
    {data.plainBlurb ? (
      <>
        <p class="only-plain mt-3 text-[0.975rem] leading-relaxed text-ink-muted">{data.plainBlurb}</p>
        <p class="only-eng mt-3 text-[0.975rem] leading-relaxed text-ink-muted">{data.blurb}</p>
      </>
    ) : (
      <p class="mt-3 text-[0.975rem] leading-relaxed text-ink-muted">{data.blurb}</p>
    )}
    <p class="only-eng mt-3 line-clamp-3 text-sm leading-relaxed text-ink-muted/90">{data.problem}</p>

    <!-- These are the numbers that used to sit in the page hero. They belong
         to the system, not to a paragraph about me. -->
    {inlineMetrics.length > 0 && (
      <dl
        class:list={[
          'mt-5 grid gap-3',
          // Four metrics in a three-column grid leaves an orphan on the second
          // row. The count varies with whether a cover is carrying the first one.
          inlineMetrics.length === 4 ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-3',
        ]}
      >
        {inlineMetrics.map((m) => (
          <div class="rounded-xl border border-border bg-bg/60 p-3">
            <dd class="font-display text-xl font-bold text-ink">{m.value}</dd>
            <dt class="mt-0.5 text-[11px] uppercase tracking-wide text-ink-faint">{m.label}</dt>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-auto flex items-center justify-between pt-6">
      <ul class="flex flex-wrap gap-1.5">
        {data.stack.slice(0, 4).map((tech) => (
          <li class="rounded-md bg-surface-raised px-2 py-0.5 text-xs text-ink-muted">{tech}</li>
        ))}
      </ul>
      <span class="text-sm font-medium text-accent transition-transform group-hover:translate-x-0.5">
        Read the write-up →
      </span>
    </div>
  </div>
</article>
