---
import { Image } from 'astro:assets';
import { coverGradient, statusLabel, type Project } from '../../lib/content';

/** The flagship card on the home page: one project, full width, metrics
 *  visible without a click. */
interface Props { project: Project }
const { project } = Astro.props;
const { data, id } = project;
---
<article class="tile reveal group grid overflow-hidden md:grid-cols-[1.1fr_1fr]">
  <div class="relative min-h-56 overflow-hidden bg-surface-raised md:min-h-full">
    {data.cover ? (
      <Image
        src={data.cover}
        alt={data.coverAlt ?? ''}
        class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        widths={[640, 1024]}
        sizes="(max-width: 768px) 100vw, 640px"
      />
    ) : (
      <div class="size-full" style={`background: ${coverGradient(id)}`}>
        <div class="absolute inset-0 grid place-items-center p-8">
          <p class="font-display text-center text-3xl font-bold leading-tight text-white/90 drop-shadow sm:text-4xl">
            {data.title}
          </p>
        </div>
      </div>
    )}
    <span class="absolute left-4 top-4 rounded-full bg-black/40 px-2.5 py-1 text-xs font-medium text-white backdrop-blur">
      Featured
    </span>
  </div>

  <div class="flex flex-col p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2 text-xs text-ink-faint">
      <span
        class:list={[
          'rounded-full px-2 py-0.5 font-medium',
          data.status === 'live' && 'bg-ok/15 text-ok',
          data.status === 'wip' && 'bg-warn/15 text-warn',
          data.status === 'archived' && 'bg-ink-faint/15 text-ink-muted',
        ]}
      >
        {statusLabel[data.status]}
      </span>
      {data.role && <span>· {data.role}</span>}
      <time datetime={data.date.toISOString()}>
        · {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
      </time>
    </div>

    <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      <a href={`/projects/${id}`} class="after:absolute after:inset-0">{data.title}</a>
    </h3>
    <p class="mt-3 text-[0.975rem] leading-relaxed text-ink-muted">{data.blurb}</p>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-muted/90">{data.problem}</p>

    {data.metrics.length > 0 && (
      <dl class="mt-5 grid grid-cols-3 gap-3">
        {data.metrics.slice(0, 3).map((m) => (
          <div class="rounded-xl border border-border bg-bg/60 p-3">
            <dd class="font-display text-xl font-bold text-ink">{m.value}</dd>
            <dt class="mt-0.5 text-[11px] uppercase tracking-wide text-ink-faint">{m.label}</dt>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-auto flex items-center justify-between pt-6">
      <ul class="flex flex-wrap gap-1.5">
        {data.stack.slice(0, 4).map((tech) => (
          <li class="rounded-md bg-surface-raised px-2 py-0.5 text-xs text-ink-muted">{tech}</li>
        ))}
      </ul>
      <span class="text-sm font-medium text-accent transition-transform group-hover:translate-x-0.5">
        Read the write-up →
      </span>
    </div>
  </div>
</article>
