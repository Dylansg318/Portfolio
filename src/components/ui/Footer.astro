---
import { site } from '../../lib/site';
const year = new Date().getFullYear();
---
<!-- A reference's footer: one line of who, one line of where else. The dark
     response column above it ends at this hairline. -->
<footer class="site-foot border-t border-border">
  <div class="in">
    <p>
      <span class="text-ink">{site.name}</span> · {site.role} · {site.location} · {site.timezone}
      · <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <ul>
      {site.links.github && <li><a href={site.links.github} rel="me noopener">GitHub</a></li>}
      {site.links.linkedin && <li><a href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>}
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/api/dylan" class="mono">/api</a></li>
      <!-- Help desk: the same portfolio re-served as a service-management
           tool at /desk. data-astro-reload: /desk opts out of the router, so
           this crossing has to be a real navigation rather than a swap. -->
      <li><a href="/desk" data-astro-reload>Help desk</a></li>
    </ul>
    <p class="meta">© {year} {site.name}. Numbers measured {site.statsAsOf}. Built with Astro, deployed on Cloudflare Workers.</p>
  </div>
</footer>

<style>
  .in {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1.5rem 1rem 5.5rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
  @media (min-width: 640px) {
    .in { padding-inline: 1.5rem; grid-template-columns: minmax(0, 1fr) auto; }
    .meta { grid-column: 1 / -1; }
  }
  ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--ink); }
  p a { color: var(--ink-muted); }
</style>
