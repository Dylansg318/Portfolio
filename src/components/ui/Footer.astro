---
import { site } from '../../lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-border">
  <div class="mx-auto max-w-(--container-wide) px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-lg font-semibold text-ink">{site.name}</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-muted">
          {site.role}. {site.location} · {site.timezone}.
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-3 inline-block text-sm text-accent underline-offset-4 transition-colors hover:text-accent-hover hover:underline"
        >
          {site.email}
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Site</p>
        <ul class="mt-3 space-y-2 text-sm">
          {site.nav.map((item) => (
            <li>
              <a class="text-ink-muted transition-colors hover:text-ink" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
          <li><a class="text-ink-muted transition-colors hover:text-ink" href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Elsewhere</p>
        <ul class="mt-3 space-y-2 text-sm">
          {site.links.github && (
            <li>
              <a class="text-ink-muted transition-colors hover:text-ink" href={site.links.github} rel="me noopener">
                GitHub
              </a>
            </li>
          )}
          {site.links.linkedin && (
            <li>
              <a class="text-ink-muted transition-colors hover:text-ink" href={site.links.linkedin} rel="me noopener">
                LinkedIn
              </a>
            </li>
          )}
          <li><a class="text-ink-muted transition-colors hover:text-ink" href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-border pt-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. Built with Astro, deployed on Cloudflare Workers.</p>
      <div class="flex flex-wrap items-center gap-3">
        <p>Numbers measured {site.statsAsOf}.</p>
        <!-- Skin A/B: same site, two design languages. ?skin=slip links work too. -->
        <div class="flex items-center gap-1 rounded-md border border-border p-0.5" role="group" aria-label="Site look">
          <span class="px-1 text-[10px] uppercase tracking-wider">Look</span>
          <button type="button" data-skin-btn="meadow" class="rounded px-1.5 py-0.5 transition-colors hover:text-ink">Meadow</button>
          <button type="button" data-skin-btn="slip" class="rounded px-1.5 py-0.5 transition-colors hover:text-ink">Packing slip</button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const skinBtns = document.querySelectorAll<HTMLButtonElement>('[data-skin-btn]');

  const paintSkin = () => {
    const skin = document.documentElement.dataset.skin === 'slip' ? 'slip' : 'meadow';
    skinBtns.forEach((b) => {
      const on = b.dataset.skinBtn === skin;
      b.classList.toggle('bg-surface-raised', on);
      b.classList.toggle('text-ink', on);
      b.classList.toggle('font-semibold', on);
      b.setAttribute('aria-pressed', String(on));
    });
  };

  skinBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const skin = b.dataset.skinBtn === 'slip' ? 'slip' : 'meadow';
      if (skin === 'slip') {
        document.documentElement.dataset.skin = 'slip';
      } else {
        delete document.documentElement.dataset.skin;
      }
      try {
        localStorage.setItem('skin', skin);
      } catch {
        /* storage blocked — still flips for this page view */
      }
      paintSkin();
    }),
  );

  paintSkin();
</script>
