---
// No framework needed for a two-state toggle — this is ~15 lines of vanilla JS
// and shipping React for it would defeat the point of the whole stack.
---
<button
  type="button"
  id="theme-toggle"
  class="grid size-9 shrink-0 place-items-center rounded-lg text-nav-muted transition-colors hover:bg-white/10 hover:text-nav-ink"
  aria-label="Toggle colour theme"
>
  <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
</button>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked — the toggle still works for this page view */
      }
    });
  });
</script>
