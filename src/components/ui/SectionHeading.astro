---
/** The heading every home/about section shares: eyebrow, title, optional
 *  lead and an optional right-aligned link. */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  link?: { href: string; label: string };
  id?: string;
}
const { eyebrow, title, lead, link, id } = Astro.props;
---
<div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4" id={id}>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h2>
    {lead && <p class="mt-3 max-w-(--container-reading) text-lg text-ink-muted">{lead}</p>}
  </div>
  {link && (
    <a
      href={link.href}
      class="group inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-hover"
    >
      {link.label}
      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>
  )}
</div>
