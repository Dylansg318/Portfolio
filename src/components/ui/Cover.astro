---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A project's cover screenshot.
 *
 * One capture, in the product's own light theme. The site has one theme
 * (see the token block in global.css), so the old light/dark twin swap is
 * gone; a screenshot sits on the white prose column the way it sits in the
 * product. Astro's <Image> defaults to loading="lazy" — keep it that way,
 * eager here would put every card's image on the critical path.
 */
interface Props {
  cover: ImageMetadata;
  alt: string;
  class?: string;
  widths: number[];
  sizes: string;
}

const { cover, alt, class: className, widths, sizes } = Astro.props;
---

<Image src={cover} alt={alt} class={className} widths={widths} sizes={sizes} />
