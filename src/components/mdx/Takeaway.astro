---
/** Pull-quote for a lesson worth interrupting the prose for. */
interface Props {
  label?: string;
}
const { label = 'Takeaway' } = Astro.props;
---
<aside class="not-prose my-8 rounded-md border border-border bg-surface-raised p-5">
  <p class="mono mb-2 text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-accent">{label}</p>
  <div class="text-[0.95rem] leading-relaxed text-ink [&>p:last-child]:mb-0 [&>p]:mb-3">
    <slot />
  </div>
</aside>
