---
/** Pull-quote for a lesson worth interrupting the prose for. */
interface Props {
  label?: string;
}
const { label = 'Takeaway' } = Astro.props;
---
<aside class="not-prose my-8 rounded-xl border border-accent/30 bg-accent-wash/40 p-5">
  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-accent">{label}</p>
  <div class="text-[0.975rem] leading-relaxed text-ink [&>p:last-child]:mb-0 [&>p]:mb-3">
    <slot />
  </div>
</aside>
