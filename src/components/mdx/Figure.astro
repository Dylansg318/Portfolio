---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Let a diagram break out past the reading measure. */
  wide?: boolean;
}
const { src, alt, caption, wide = false } = Astro.props;
---
<figure class:list={['not-prose my-8', wide && 'lg:-mx-24']}>
  <Image
    src={src}
    alt={alt}
    class="w-full rounded-xl border border-border"
    widths={[480, 800, 1200]}
    sizes="(max-width: 768px) 100vw, 800px"
  />
  {caption && <figcaption class="mt-2 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
