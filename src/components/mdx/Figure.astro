---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /**
   * The same shot with the product in ITS dark theme — see ui/Cover.astro for
   * why this is a CSS swap on `[data-theme]` rather than a `<picture>` media
   * query. Optional: without it, `src` renders in both themes, which is right
   * for a diagram or for art that has no theme. Frame the two identically;
   * they swap in place, so a different crop reads as the page jumping.
   */
  srcDark?: ImageMetadata;
  alt: string;
  caption?: string;
  /** Let a diagram break out past the reading measure. */
  wide?: boolean;
}
const { src, srcDark, alt, caption, wide = false } = Astro.props;

// Written out rather than spread: <Image>'s props are a union, and spreading an
// object loses the overload that lets `widths` stand in for width/height.
const CLS = 'w-full rounded-xl border border-border';
const WIDTHS = [480, 800, 1200];
const SIZES = '(max-width: 768px) 100vw, 800px';
---
<figure class:list={['not-prose my-8', wide && 'lg:-mx-24']}>
  {srcDark ? (
    <>
      <Image src={src} alt={alt} class:list={[CLS, 'dark:hidden']} widths={WIDTHS} sizes={SIZES} />
      <Image
        src={srcDark}
        alt={alt}
        class:list={[CLS, 'hidden dark:block']}
        widths={WIDTHS}
        sizes={SIZES}
      />
    </>
  ) : (
    <Image src={src} alt={alt} class={CLS} widths={WIDTHS} sizes={SIZES} />
  )}
  {caption && <figcaption class="mt-2 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
