---
import Method from './Method.astro';
import { endpoint } from '../../lib/endpoints';

/**
 * The endpoint rail: the site's one navigation, in the API's own terms.
 * Every entry is a page's plain name over the endpoint that page is, so a
 * Plain English reader and an engineer both find their way without flipping
 * the switch. Sticky beside the rows from 1280px; a strip of the names under
 * the header below that.
 *
 * `current` names the entry for this page. A page whose rows are themselves
 * endpoints (the home page) passes anchors for those entries, and the small
 * script below moves the highlight as the reader scrolls. A project page
 * passes its own id so `{id}` reads resolved.
 *
 * Each entry's name, method, path and page come from the endpoint list, so
 * the rail, `GET /api` and the /reference page cannot disagree about what a
 * page is. Only the order and the indents are decided here.
 */
interface Props {
  current?: string;
  /** Per-key href overrides — the home page points its own rows at anchors. */
  hrefs?: Record<string, string>;
  /** Per-key path overrides — a project page resolves `{id}` to its own id. */
  paths?: Record<string, string>;
}
const { current, hrefs = {}, paths = {} } = Astro.props;

type Slot = {
  key: string;
  /** Indented under the entry before it; not shown on the strip. */
  sub?: boolean;
  /** The index, under a hairline; not shown on the strip. */
  idx?: boolean;
};
const ORDER: Slot[] = [
  { key: 'dylan' },
  { key: 'work' },
  { key: 'project', sub: true },
  { key: 'experience' },
  { key: 'resume' },
  { key: 'contact' },
  { key: 'index', idx: true },
];
const ITEMS = ORDER.map((slot) => {
  const ep = endpoint(slot.key);
  return { ...slot, label: ep.page.label, method: ep.method, path: ep.path, href: ep.page.href };
});
// On a project page the current entry is Work's child, so Work is "open":
// lit on the strip, where the child is hidden; just bold in the column.
const open = current === 'project' ? 'work' : undefined;
---
<nav class="rail" aria-label="Reference">
  <p class="cap">Reference</p>
  <ol>
    {ITEMS.map((it) => (
      <li class:list={{ sub: it.sub, idx: it.idx }}>
        <a
          href={hrefs[it.key] ?? it.href}
          data-rail={it.key}
          aria-current={it.key === current ? 'page' : undefined}
          data-open={it.key === open ? 'true' : undefined}
        >
          <span class="lbl">{it.label}</span>
          <span class="ep-ref"><Method method={it.method} /><span class="mono">{paths[it.key] ?? it.path}</span></span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  // Scroll-spy for a page whose rows are endpoints: as a row with an id
  // reaches the top third of the viewport, its rail entry lights. Anchors
  // only — an entry that links to another page keeps its server-set state.
  document.addEventListener('astro:page-load', () => {
    const rail = document.querySelector<HTMLElement>('.rail');
    if (!rail) return;
    // On a phone the rail is a strip; bring the current entry into view
    // without moving the page.
    const list = rail.querySelector<HTMLElement>('ol');
    const current = rail.querySelector<HTMLElement>('a[aria-current="page"], a[data-open="true"]');
    if (list && current && list.scrollWidth > list.clientWidth) {
      list.scrollLeft = Math.max(0, current.offsetLeft - (list.clientWidth - current.offsetWidth) / 2);
    }
    const anchors = [...rail.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    if (anchors.length === 0 || !('IntersectionObserver' in window)) return;
    const rows = anchors
      .map((a) => document.getElementById(a.getAttribute('href')!.slice(1)))
      .filter((el): el is HTMLElement => !!el);
    const light = (id: string) =>
      anchors.forEach((a) => a.setAttribute('aria-current', a.getAttribute('href') === `#${id}` ? 'true' : 'false'));
    const io = new IntersectionObserver(
      (entries) => {
        // On the home page's still frame every row is a layer in the same
        // place, so they all intersect; the frame sets the entry itself.
        if (document.documentElement.classList.contains('still')) return;
        const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (hit) light((hit.target as HTMLElement).id);
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
    );
    rows.forEach((r) => io.observe(r));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
