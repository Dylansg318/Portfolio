---
import Base from '../layouts/Base.astro';
import FeaturedProject from '../components/ui/FeaturedProject.astro';
import WorkRow from '../components/ui/WorkRow.astro';
import { site } from '../lib/site';
import { getProjects } from '../lib/content';

/** Three sections: who, the work, how to reach me.
 *
 *  This page used to render most of site.ts — six sections and seventeen
 *  boxes — which described the ERP four times before you reached its
 *  write-up. Everything cut from here still exists: the principles and the
 *  path are on /about, the job history is on /resume. A front page that
 *  repeats them is not more informative, only longer. */
const projects = await getProjects();
const [flagship, ...rest] = projects;
---
<Base>
  <!-- ============================== NAMEPLATE ========================= -->
  <section>
    <div class="mx-auto max-w-(--container-wide) px-4 pb-14 pt-16 sm:px-6 sm:pb-20 sm:pt-24">
      <h1 class="reveal reveal-load font-display text-5xl font-extrabold leading-[0.95] tracking-tight text-ink sm:text-7xl lg:text-8xl">
        {site.name}
      </h1>

      <p
        class="reveal reveal-load mt-5 text-xs uppercase tracking-[0.18em] text-ink-faint sm:text-sm"
        style="--reveal-delay: 60ms"
      >
        Software engineer · {site.location} · {site.timezone}
      </p>

      <!-- One sentence of employment. Deliberately not a slogan: it says where
           I work and what I own, and nothing about how good I am at it. -->
      <p
        class="reveal reveal-load mt-8 max-w-(--container-reading) text-lg leading-relaxed text-ink-muted sm:text-xl"
        style="--reveal-delay: 120ms"
      >
        Operations Technology Manager at{' '}
        <a href={site.employer.site} rel="noopener" class="text-ink underline decoration-border-strong underline-offset-4 transition-colors hover:decoration-accent">
          {site.employer.name}
        </a>, {site.employer.kind}. I built and run MHLHUB — the system the company
        works in — and the environments the rest of the business ships through.
      </p>

      <div class="reveal reveal-load mt-9 flex flex-wrap gap-3" style="--reveal-delay: 180ms">
        <a href="#work" class="btn btn-primary">
          See the work
          <span aria-hidden="true">→</span>
        </a>
        <a href={site.resumeUrl} class="btn btn-ghost">Resume</a>
        {site.links.github && (
          <a href={site.links.github} rel="me noopener" class="btn btn-ghost">
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
            </svg>
            GitHub
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ============================== THE WORK ========================== -->
  <section id="work" class="border-t border-border">
    <div class="mx-auto max-w-(--container-wide) px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow reveal">The work</p>

      {projects.length === 0 ? (
        <p class="mt-8 rounded-xl border border-dashed border-border p-10 text-center text-ink-muted">
          No projects published yet.
        </p>
      ) : (
        <>
          {flagship && (
            <div class="mt-8">
              <FeaturedProject project={flagship} />
            </div>
          )}

          {/* Rows, not cards. See WorkRow.astro for why. */}
          <div class="mt-10 border-t border-border">
            {rest.map((project, i) => <WorkRow project={project} delay={i * 50} />)}
          </div>

          <p class="mt-8">
            <a href="/projects" class="text-sm font-medium text-accent hover:underline">
              All projects, including the parts of MHLHUB →
            </a>
          </p>
        </>
      )}
    </div>
  </section>

  <!-- =============================== CONTACT ========================== -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-(--container-wide) px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow reveal">Contact</p>
      <p class="reveal mt-4 max-w-(--container-reading) text-lg leading-relaxed text-ink-muted">
        {site.location} · {site.timezone}. I reply within a day.
      </p>
      <div class="reveal mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href={`mailto:${site.email}`} class="text-ink-muted underline decoration-border-strong underline-offset-4 transition-colors hover:text-ink hover:decoration-accent">
          {site.email}
        </a>
        {site.links.github && (
          <a href={site.links.github} rel="me noopener" class="text-ink-muted underline decoration-border-strong underline-offset-4 transition-colors hover:text-ink hover:decoration-accent">
            GitHub
          </a>
        )}
        {site.links.linkedin && (
          <a href={site.links.linkedin} rel="me noopener" class="text-ink-muted underline decoration-border-strong underline-offset-4 transition-colors hover:text-ink hover:decoration-accent">
            LinkedIn
          </a>
        )}
      </div>
    </div>
  </section>
</Base>
