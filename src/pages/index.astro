---
import Base from '../layouts/Base.astro';
import HomeProject from '../components/ui/HomeProject.astro';
import Nameplate from '../components/ui/Nameplate.astro';
import Cover from '../components/ui/Cover.astro';
import { site } from '../lib/site';
import { getProjects } from '../lib/content';

// Curate for breadth: production ownership, developer tooling, and an
// independent product. The complete catalog remains on /projects.
const projects = await getProjects();
const selections = [
  { id: 'internal-erp', label: 'At work', focus: "Everything the company does in a day, in one place. I'm the only engineer on it." },
  { id: 'agent-fleet', label: 'Tools for myself', focus: 'What keeps five to ten coding agents on one repo from losing work.' },
  { id: 'receipt-splitter', label: 'On the side', focus: 'The whole thing on my own, from the phone camera to the split.' },
];
const selected = selections.flatMap((selection) => {
  const project = projects.find((p) => p.id === selection.id);
  return project ? [{ ...selection, project }] : [];
});
const game = projects.find((p) => p.id === 'galaxy-defense');
---
<Base>
  <section aria-labelledby="intro-heading">
    <div class="mx-auto max-w-(--container-wide) px-4 pb-16 pt-16 sm:px-6 sm:pb-20 sm:pt-24">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:items-end lg:gap-16">
        <div class="reveal reveal-load">
          <p class="eyebrow">{site.role}</p>
          <h1 id="intro-heading" class="mt-6 font-display text-[clamp(3rem,8vw,5rem)] lg:text-[clamp(3rem,6.5vw,5rem)] font-extrabold leading-[0.94] tracking-[-0.055em] text-ink">
            Dylan{' '}<span class="block whitespace-nowrap">San Gabriel<span class="text-accent">.</span></span>
          </h1>
          <p class="mt-6 text-sm text-ink-faint">{site.location} · {site.timezone}</p>
        </div>
        <div class="reveal reveal-load" style="--reveal-delay: 100ms">
          <Nameplate class="text-lg leading-relaxed text-ink-muted sm:text-xl" />
          <p class="mt-5 text-base leading-relaxed text-ink-muted">
            Before this, software was something I had to use on a shift — a register,
            a POS, a count that never matched the shelf. Most of what I build now
            replaces something someone was doing by hand.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#work" class="btn btn-primary">See the work <span aria-hidden="true">↓</span></a>
            <a href={site.resumeUrl} class="btn btn-ghost">Resume</a>
            <a href="/about" class="btn btn-ghost">About me</a>
          </div>
        </div>
      </div>
      <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-border pt-5 text-sm text-ink-muted">
        <p><span class="text-ink">Mostly backend</span> · TypeScript, Node, Postgres</p>
        <a href="#experience" class="text-accent hover:underline">Retail → hospitality → software <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="work-heading" class="scroll-mt-24 border-t border-border">
    <div class="mx-auto max-w-(--container-wide) px-4 py-16 sm:px-6 sm:py-20">
      <div class="reveal flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="work-heading" class="mt-3 text-3xl font-bold sm:text-4xl">One at work, one for myself, one on the side.</h2>
        </div>
        <a href="/projects" class="text-sm font-medium text-accent hover:underline">All projects →</a>
      </div>
      <div class="mt-10 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {selected.map(({ project, label, focus }, i) => (
          <HomeProject project={project} label={label} focus={focus} number={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-heading" class="scroll-mt-24 border-t border-border">
    <div class="mx-auto grid max-w-(--container-wide) gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.65fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-heading" class="mt-3 text-3xl font-bold sm:text-4xl">How I got here.</h2>
        <p class="mt-5 leading-relaxed text-ink-muted">
          I managed a T-Mobile store, then ran front-of-house at a Korean BBQ restaurant.
          I was taking CS classes at George Mason the whole time, and finished a software
          testing bootcamp between shifts.
        </p>
        <a href="/about#tmobile" class="mt-5 inline-block text-sm font-medium text-accent hover:underline">The longer story →</a>
      </div>
      <ol class="career-path">
        {site.experience.map((job) => (
          <li class="reveal relative border-l border-border-strong pb-9 pl-7 last:pb-0">
            <span aria-hidden="true" class="absolute -left-[5px] top-1.5 size-[9px] rounded-full bg-accent"></span>
            <p class="font-mono text-xs text-ink-faint">{job.start} — {job.end}</p>
            <h3 class="mt-2 text-xl font-semibold">{job.title}</h3>
            <p class="mt-1 text-sm text-ink-faint">{job.org}</p>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">{job.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="personal-heading" class="border-t border-border">
    <div class="mx-auto grid max-w-(--container-wide) gap-10 px-4 py-16 sm:px-6 sm:py-20 md:grid-cols-2 md:items-center md:gap-20">
      <div class="reveal">
        <p class="eyebrow">Away from work</p>
        <h2 id="personal-heading" class="mt-3 text-3xl font-bold sm:text-4xl">Cooking, music, one more side project.</h2>
        <p class="mt-5 leading-relaxed text-ink-muted">
          I cook, I play a bit of music, and I'm always trying a restaurant I haven't
          been to yet. There's usually a side project going that I talked myself into.
        </p>
        <a href="/desk" class="mt-5 inline-block text-sm font-medium text-accent hover:underline">Take a look around my help desk →</a>
      </div>
      {game && (
        <a href={`/projects/${game.id}`} class="reveal group grid grid-cols-[7rem_1fr] items-center gap-5 border-y border-border py-6 sm:grid-cols-[9rem_1fr]">
          {game.data.cover && <Cover cover={game.data.cover} alt={game.data.coverAlt ?? ''} class="aspect-square w-full rounded-lg object-cover" widths={[160, 320]} sizes="144px" />}
          <div>
            <p class="font-mono text-xs text-ink-faint">2020 · Where it started</p>
            <h3 class="mt-2 text-xl font-semibold group-hover:text-accent">Galaxy Defense</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">A high-school game with a shop, upgrades, and a boss fight. Still playable.</p>
            <p class="mt-3 text-sm font-medium text-accent">Play &amp; read the story →</p>
          </div>
        </a>
      )}
    </div>
  </section>

  <section aria-labelledby="contact-heading" class="border-t border-border">
    <div class="mx-auto max-w-(--container-wide) px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow reveal">Contact</p>
      <h2 id="contact-heading" class="reveal mt-3 text-3xl font-bold sm:text-4xl">What I'm looking for.</h2>
      <p class="reveal mt-5 max-w-(--container-reading) text-lg leading-relaxed text-ink-muted">
        A backend or full-stack role, remote or in Northern Virginia. If that's what
        you're hiring for, let me know. The form is the quickest way to reach me; email
        works too.
      </p>
      <div class="reveal mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href={`mailto:${site.email}`} class="text-accent hover:underline">{site.email}</a>
        {site.links.github && <a href={site.links.github} rel="me noopener" class="text-ink-muted hover:underline">GitHub</a>}
        {site.links.linkedin && <a href={site.links.linkedin} rel="me noopener" class="text-ink-muted hover:underline">LinkedIn</a>}
      </div>
    </div>
  </section>
</Base>
