---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

// Deliberately a plain email page, not a form. The form scaffold still lives
// at src/pages/api/contact.ts — wire RESEND_API_KEY / CONTACT_TO and restore
// the form from git history if a structured form is ever wanted again.
const subject = encodeURIComponent('Hello from your portfolio');
---
<Base title="Contact" description={`Get in touch with ${site.name} — email, GitHub, resume.`}>
  <section>
    <div class="mx-auto max-w-(--container-reading) px-4 py-12 sm:px-6 sm:py-16">
      <p class="eyebrow reveal reveal-load">Contact</p>
      <h1 class="reveal reveal-load mt-4 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl" style="--reveal-delay: 60ms">
        Say hello.
      </h1>
      <p class="reveal reveal-load mt-5 max-w-prose text-lg leading-relaxed text-ink-muted" style="--reveal-delay: 120ms">
        Email is the whole system. There's no form and no ticket queue, it just lands in
        my inbox. {site.timezone}.
      </p>

      <div class="reveal reveal-load mt-9 flex flex-wrap items-center gap-3" style="--reveal-delay: 180ms">
        <a href={`mailto:${site.email}?subject=${subject}`} class="btn btn-primary">
          Email {site.shortName}
          <span aria-hidden="true">→</span>
        </a>
        <button type="button" id="copy-email" class="btn btn-ghost" data-email={site.email}>
          {site.email}
        </button>
      </div>
      <p id="copy-status" role="status" aria-live="polite" class="mt-2 min-h-5 text-sm text-ok"></p>

      <!-- The non-technical visitor's path. A recruiter knows what to do with a
           résumé; an owner or office manager needs to hear, in their terms,
           what kind of problem I take on and what happens after they write. -->
      <section class="reveal mt-12 rounded-2xl border border-border bg-surface p-6 sm:p-7" style="--reveal-delay: 210ms">
        <h2 class="font-display text-xl font-bold text-ink">Running a business on spreadsheets and six logins?</h2>
        <p class="mt-3 leading-relaxed text-ink-muted">
          That is the problem I have spent the last year solving for a dental distributor:
          orders from six websites that never agreed, prices updated by hand every morning,
          books that had to be reconciled at the end of every shift, a warehouse on pen and
          paper. It now runs in{' '}
          <a class="text-accent hover:underline" href="/projects/mhlhub">one system</a>, orders
          have roughly doubled, and nobody was added to operations to handle it.
        </p>
        <p class="mt-3 leading-relaxed text-ink-muted">
          If your company has a version of that, describe it in an email the way you would to a
          colleague. I will tell you plainly whether it is a software problem, what I would
          build first, and what it would take. No forms, no sales call.
        </p>
        <ul class="mt-4 grid gap-2 text-sm text-ink-muted sm:grid-cols-2">
          <li class="rounded-lg bg-surface-raised px-3 py-2">Marketplace and storefront orders in one place</li>
          <li class="rounded-lg bg-surface-raised px-3 py-2">Pricing, inventory and shipping that update themselves</li>
          <li class="rounded-lg bg-surface-raised px-3 py-2">QuickBooks that agrees with the sales system</li>
          <li class="rounded-lg bg-surface-raised px-3 py-2">Barcodes, scanners and label printing on the floor</li>
        </ul>
      </section>

      <div class="reveal mt-8 grid gap-4 sm:grid-cols-2" style="--reveal-delay: 240ms">
        <div class="tile p-5">
          <h2 class="eyebrow mb-3 text-xs">Useful to include</h2>
          <ul class="space-y-2 text-sm leading-relaxed text-ink-muted">
            <li>What you're hiring for, or what your business is stuck on</li>
            <li>Timeline, and remote / hybrid / on-site</li>
            <li>A link to the role or the company</li>
          </ul>
        </div>
        <div class="tile p-5">
          <h2 class="eyebrow mb-3 text-xs">Elsewhere</h2>
          <ul class="space-y-2 text-sm leading-relaxed">
            {site.links.github && (
              <li><a class="text-accent hover:underline" href={site.links.github} rel="me noopener">GitHub</a></li>
            )}
            {site.links.linkedin && (
              <li><a class="text-accent hover:underline" href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>
            )}
            <li><a class="text-accent hover:underline" href={site.resumeUrl}>Resume</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('copy-email');
    const status = document.getElementById('copy-status');
    btn?.addEventListener('click', async () => {
      const email = (btn as HTMLElement).dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (status) status.textContent = 'Copied to clipboard.';
      } catch {
        if (status) status.textContent = email;
      }
    });
  });
</script>
