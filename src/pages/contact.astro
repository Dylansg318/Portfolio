---
import Base from '../layouts/Base.astro';
import Rail from '../components/ref/Rail.astro';
import Row from '../components/ref/Row.astro';
import Crumb from '../components/ref/Crumb.astro';
import Console from '../components/ref/Console.astro';
import { site } from '../lib/site';
import { projectById } from '../lib/api';

// Deliberately a plain email page, not a form. POST /api/contact validates
// for real and, until RESEND_API_KEY / CONTACT_TO are set, answers 503 with a
// mailto link the console opens — so the write in the API is honest about
// what it can do. Configure the two secrets and the same console delivers.
const subject = encodeURIComponent('Hello from your portfolio');
const contactAtRest = {
  to: site.email,
  subject: 'Hello from your portfolio',
  message: '(waiting for your message)',
};
const erp = await projectById('internal-erp', ['problem', 'metrics']);
---
<Base title="Contact" description={`Get in touch with ${site.name} — email, GitHub, resume.`}>
  <div class="ref">
    <Rail current="contact" />
    <div class="ref-main">
      <Row id="contact">
        <Crumb method="POST" path="/api/contact" />
        <h1 class="page">Say hello.</h1>
        <p class="lead">
          Email is the whole system. There's no form and no ticket queue, it just lands in my
          inbox. {site.timezone}.
        </p>
        <div class="actions">
          <a href={`mailto:${site.email}?subject=${subject}`} class="btn btn-primary">
            Email {site.shortName}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button type="button" id="copy-email" class="btn btn-ghost mono" data-email={site.email}>{site.email}</button>
          {site.links.github && <a class="c-link quiet" href={site.links.github} rel="me noopener">GitHub</a>}
          {site.links.linkedin && <a class="c-link quiet" href={site.links.linkedin} rel="me noopener">LinkedIn</a>}
        </div>
        <p id="copy-status" role="status" aria-live="polite" class="status"></p>

        <h2 class="mt">Useful to include</h2>
        <ul class="bullets">
          <li>What you're hiring for, or what your business is stuck on</li>
          <li>Timeline, and remote / hybrid / on-site</li>
          <li>A link to the role or the company</li>
        </ul>
        <p class="t">
          Or write it in the console on the right and press Send — it validates the message the
          way the API does, then hands it to your mail app.
        </p>
        <Console
          slot="code"
          id="contact"
          endpoint="contact"
          body={contactAtRest}
          status={0}
          frame="Live: the route validates for real. Until mail delivery is configured it answers 503 with a mailto link, and Send opens it with your message in it."
        />
      </Row>

      <!-- The non-technical visitor's path. A recruiter knows what to do with a
           résumé; an owner or office manager needs to hear, in their terms,
           what kind of problem I take on and what happens after they write. -->
      <Row id="business">
        <h2>Running a business on spreadsheets and six logins?</h2>
        <p class="t">
          That's the problem I've spent the last year solving for a dental distributor: orders
          from six websites that never agreed, prices updated by hand every morning, books that
          had to be reconciled at the end of every shift, a warehouse on pen and paper. It now
          runs in <a href="/projects/internal-erp">one system</a>, orders have roughly doubled,
          and nobody was added to operations to handle it.
        </p>
        <p class="t">
          If your company has a version of that, describe it in an email the way you would to a
          colleague. I'll tell you straight whether it's a software problem, what I'd build
          first, and what it'd take. No forms, no sales call.
        </p>
        <ul class="chips">
          <li>Marketplace and storefront orders in one place</li>
          <li>Pricing, inventory and shipping that update themselves</li>
          <li>QuickBooks that agrees with the sales system</li>
          <li>Barcodes, scanners and label printing on the floor</li>
        </ul>
        <Console
          slot="code"
          id="erp"
          endpoint="project"
          params={{ id: 'internal-erp', fields: 'problem,metrics' }}
          options={{ id: [{ value: 'internal-erp', label: 'internal-erp' }] }}
          body={erp}
        />
      </Row>
    </div>
  </div>
</Base>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('copy-email');
    const status = document.getElementById('copy-status');
    btn?.addEventListener('click', async () => {
      const email = (btn as HTMLElement).dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (status) status.textContent = 'Copied to clipboard.';
      } catch {
        if (status) status.textContent = email;
      }
    });
  });
</script>
