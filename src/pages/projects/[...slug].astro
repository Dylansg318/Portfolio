---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Demo from '../../components/mdx/Demo.astro';
import CodeFile from '../../components/mdx/CodeFile.astro';
import Video from '../../components/mdx/Video.astro';
import Figure from '../../components/mdx/Figure.astro';
import Takeaway from '../../components/mdx/Takeaway.astro';
import PlainOnly from '../../components/mdx/PlainOnly.astro';
import EngOnly from '../../components/mdx/EngOnly.astro';
import { getAllProjects, getChildren, getProjectNeighbours, statusLabel } from '../../lib/content';

// Routes come from getAllProjects, not getProjects: subsystems are hidden from
// LISTINGS, not from the site. The draft exclusion still gates route generation
// here — filtering only the listing would leave drafts live at their own URL.
export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const { prev, next } = await getProjectNeighbours(project.id);

// A subsystem shows where it belongs; a parent shows what it contains.
const all = await getAllProjects();
const parent = data.parent ? all.find((p) => p.id === data.parent) : undefined;
const children = await getChildren(project.id);

// Components available inside the MDX body.
const components = { Demo, CodeFile, Video, Figure, Takeaway, PlainOnly, EngOnly };
---

<Base
  title={data.title}
  description={data.blurb}
  ogImage={`/og/projects/${project.id}.png`}
>
  <article>
    <!-- Hero -->
    <header class="border-b border-border">
      <div class="mx-auto max-w-(--container-wide) px-4 py-12 sm:px-6 sm:py-16">
        <!-- A subsystem says what it is part of. Landing on the repricing
             write-up from a search result should never leave a reader unsure
             whether they are looking at a standalone tool or one organ of
             something larger. -->
        {parent ? (
          <nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-ink-muted" aria-label="Breadcrumb">
            <a href="/projects" class="transition-colors hover:text-ink">All projects</a>
            <span aria-hidden="true" class="text-ink-faint">/</span>
            <a href={`/projects/${parent.id}`} class="transition-colors hover:text-ink">
              {parent.data.title.split(',')[0]}
            </a>
            <span aria-hidden="true" class="text-ink-faint">/</span>
            <span class="text-ink-faint">
              {project.id.split('/').pop()!.replace(/-/g, ' ').replace(/^./, (c: string) => c.toUpperCase())}
            </span>
          </nav>
        ) : (
          <a
            href="/projects"
            class="mb-8 inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-ink"
          >
            <span aria-hidden="true">←</span> All projects
          </a>
        )}

        <div class="flex flex-wrap items-center gap-3 text-sm">
          <span
            class:list={[
              'rounded-full px-2.5 py-1 text-xs font-medium',
              data.status === 'live' && 'bg-ok/15 text-ok',
              data.status === 'wip' && 'bg-warn/15 text-warn',
              data.status === 'archived' && 'bg-ink-faint/15 text-ink-muted',
            ]}
          >
            {statusLabel[data.status]}
          </span>
          <time class="text-ink-faint" datetime={data.date.toISOString()}>
            {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          </time>
          {data.role && <span class="text-ink-faint">· {data.role}</span>}
        </div>

        <h1 class="mt-4 max-w-4xl text-4xl font-extrabold tracking-tight text-ink sm:text-6xl">
          {data.title}
        </h1>
        <p class="mt-5 max-w-(--container-reading) text-lg leading-relaxed text-ink-muted sm:text-xl">{data.blurb}</p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {data.stack.map((tech) => (
            <li class="rounded-lg border border-border bg-surface px-2.5 py-1 text-sm text-ink-muted">
              {tech}
            </li>
          ))}
        </ul>

        {(data.links.source || data.links.live || data.links.writeup) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {data.links.live && (
              <a href={data.links.live} rel="noopener" class="btn btn-primary text-sm">View live</a>
            )}
            {data.links.source && (
              <a href={data.links.source} rel="noopener" class="btn btn-ghost text-sm">Source</a>
            )}
            {data.links.writeup && (
              <a href={data.links.writeup} rel="noopener" class="btn btn-ghost text-sm">External write-up</a>
            )}
          </div>
        )}

        {data.metrics.length > 0 && (
          <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {data.metrics.map((m) => (
              <div class="tile p-4">
                <dd class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">{m.value}</dd>
                <dt class="mt-1 text-xs uppercase tracking-wide text-ink-faint">{m.label}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    {data.cover ? (
      <div class="mx-auto max-w-(--container-wide) px-4 sm:px-6">
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ''}
          class="-mt-8 w-full rounded-xl border border-border shadow-xl"
          widths={[640, 1024, 1600]}
          sizes="(max-width: 1152px) 100vw, 1152px"
        />
      </div>
    ) : null}
    <!-- A project without cover art gets NO band. The generated gradient still
         earns its place on a card, where a thumbnail slot has to hold
         something — but stretched full-width here it was a saturated slab
         carrying no information, and on the grey ground it read as the loudest
         thing on the page. Colour is for highlights; this was wallpaper. -->

    <!-- THE CONTRACT: rendered identically on every project, so a reader
         comparing two projects finds the same answers in the same place. -->
    <div class="mx-auto max-w-(--container-reading) px-4 py-12 sm:px-6">
      <section class="grid gap-6 sm:grid-cols-2">
        <div class="tile p-6">
          <h2 class="eyebrow mb-3 !font-sans text-xs !tracking-[0.12em]">The problem</h2>
          <p class="text-[0.975rem] leading-relaxed text-ink">{data.problem}</p>
        </div>
        <div class="tile p-6">
          <h2 class="eyebrow mb-3 !font-sans text-xs !tracking-[0.12em]">What was unique</h2>
          <p class="text-[0.975rem] leading-relaxed text-ink">{data.unique}</p>
        </div>
      </section>

      {data.aiNote && (
        <aside class="mt-6 flex gap-4 rounded-2xl border border-border bg-surface/60 p-5">
          <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg bg-surface-raised text-sm font-bold text-ink-muted" aria-hidden="true">
            AI
          </span>
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-faint">Where AI fit in</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{data.aiNote}</p>
          </div>
        </aside>
      )}

      <!-- The parts of the system, before the long read rather than after it.
           Someone who came for "how does the repricing work" should not have
           to finish 1,300 words about the whole ERP to find out that there is
           a dedicated write-up for it. -->
      {children.length > 0 && (
        <section class="mt-12">
          <h2 class="eyebrow mb-4 !font-sans text-xs !tracking-[0.12em]">Inside it</h2>
          <div class="grid gap-3 sm:grid-cols-3">
            {children.map((child) => (
              <a
                href={`/projects/${child.id}`}
                class="tile group flex flex-col p-5 transition-colors hover:border-border-strong"
              >
                <h3 class="font-display text-base font-bold leading-snug text-ink transition-colors group-hover:text-accent">
                  {child.data.title}
                </h3>
                {child.data.metrics[0] && (
                  <p class="mt-3 font-display text-2xl font-extrabold tracking-tight text-ink">
                    {child.data.metrics[0].value}{' '}
                    <span class="font-sans text-xs font-medium uppercase tracking-wide text-ink-faint">
                      {child.data.metrics[0].label}
                    </span>
                  </p>
                )}
                <span class="mt-auto pt-4 text-sm font-medium text-accent transition-transform group-hover:translate-x-0.5">
                  Read it →
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="prose-portfolio mt-12">
        <Content components={components} />
      </div>

      <section class="mt-12 rounded-2xl border border-accent/25 bg-accent-wash/30 p-6 sm:p-8">
        <h2 class="eyebrow mb-4 !font-sans text-xs !tracking-[0.12em] !text-accent">What I learned</h2>
        <ul class="space-y-3">
          {data.learned.map((lesson) => (
            <li class="flex gap-3 text-[0.975rem] leading-relaxed text-ink">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>{lesson}</span>
            </li>
          ))}
        </ul>
      </section>

      {(prev || next) && (
        <nav class="mt-12 flex gap-4 border-t border-border pt-8" aria-label="More projects">
          {prev && (
            <a href={`/projects/${prev.id}`} class="group flex-1 text-left">
              <span class="text-xs uppercase tracking-wide text-ink-faint">Previous</span>
              <span class="mt-1 block font-medium text-ink transition-colors group-hover:text-accent">
                {prev.data.title}
              </span>
            </a>
          )}
          {next && (
            <a href={`/projects/${next.id}`} class="group flex-1 text-right">
              <span class="text-xs uppercase tracking-wide text-ink-faint">Next</span>
              <span class="mt-1 block font-medium text-ink transition-colors group-hover:text-accent">
                {next.data.title}
              </span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
</Base>
