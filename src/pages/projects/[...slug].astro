---
import { render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from '../../layouts/Base.astro';
import Rail from '../../components/ref/Rail.astro';
import Row from '../../components/ref/Row.astro';
import Crumb from '../../components/ref/Crumb.astro';
import Console from '../../components/ref/Console.astro';
import Demo from '../../components/mdx/Demo.astro';
import CodeFile from '../../components/mdx/CodeFile.astro';
import Video from '../../components/mdx/Video.astro';
import Figure from '../../components/mdx/Figure.astro';
import Takeaway from '../../components/mdx/Takeaway.astro';
import PlainOnly from '../../components/mdx/PlainOnly.astro';
import EngOnly from '../../components/mdx/EngOnly.astro';
import Cover from '../../components/ui/Cover.astro';
import { getAllProjects, getChildren, getProjectNeighbours, statusLabel } from '../../lib/content';
import { projectById } from '../../lib/api';

// Routes come from getAllProjects, not getProjects: subsystems are hidden from
// LISTINGS, not from the site. The draft exclusion still gates route generation
// here — filtering only the listing would leave drafts live at their own URL.
export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const { prev, next } = await getProjectNeighbours(project.id);

// A subsystem shows where it belongs; a parent shows what it contains.
const all = await getAllProjects();
const parent = data.parent ? all.find((p) => p.id === data.parent) : undefined;
const children = await getChildren(project.id);
const ids = all.map((p) => ({ value: p.id, label: p.id }));

// Components available inside the MDX body.
const components = { Demo, CodeFile, Video, Figure, Takeaway, PlainOnly, EngOnly };

// The responses at rest — from the same functions the Worker route calls.
const full = await projectById(project.id);
const contractFields = data.aiNote ? ['problem', 'unique', 'ai'] : ['problem', 'unique'];
const contract = await projectById(project.id, contractFields);
const learned = await projectById(project.id, ['learned']);
const inside = children.length > 0 ? await projectById(project.id, ['subsystems']) : null;

const playable = data.demo.kind !== 'none' && data.demo.fullscreen;
const when = data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const sections = (headings as MarkdownHeading[]).filter((h) => h.depth === 2);
---

<Base
  title={data.title}
  description={data.blurb}
  ogImage={`/og/projects/${project.id}.png`}
>
  <div class="ref">
    <Rail current="project" hrefs={{ project: `/projects/${project.id}` }} paths={{ project: `/api/work/${project.id}` }} />
    <article class="ref-main">
      <Row id="project">
        <!-- A subsystem says what it is part of. Landing on the repricing
             write-up from a search result should never leave a reader unsure
             whether they are looking at a standalone tool or one organ of
             something larger. -->
        {parent ? (
          <nav class="back" aria-label="Breadcrumb">
            <a href="/projects">All work</a> <span class="quiet">/</span>
            <a href={`/projects/${parent.id}`}>{parent.data.title.split(/,| that /)[0]}</a> <span class="quiet">/</span>
            <span class="quiet">{project.id.split('/').pop()!.replace(/-/g, ' ')}</span>
          </nav>
        ) : (
          <p class="back"><a href="/projects">← All work</a></p>
        )}
        <Crumb method="GET" path={`/api/work/${project.id}`} />
        <h1 class="page">{data.title}</h1>
        <p class="status">
          {statusLabel[data.status]} · <time datetime={data.date.toISOString()}>{when}</time>{data.role && ` · ${data.role}`}
        </p>
        <p class="lead">
          <span class="only-plain">{data.plainBlurb ?? data.blurb}</span>
          <span class="only-eng">{data.blurb}</span>
        </p>
        <ul class="chips">
          {data.stack.map((tech) => <li>{tech}</li>)}
        </ul>

        {(playable || data.links.live || data.links.source || data.links.writeup) && (
          <div class="actions">
            {playable && data.demo.kind === 'island' && (
              <a
                href={`/play/${project.id}`}
                class="btn btn-primary"
                data-play={data.demo.entry}
                data-play-title={data.title}
                data-play-href={`/play/${project.id}`}
                data-play-keyboard={data.demo.keyboard ? '' : undefined}
                aria-expanded="false"
              >Play here <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"/></svg></a>
            )}
            {playable && data.demo.kind !== 'island' && <a href={`/play/${project.id}`} class="btn btn-primary">Play <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>}
            {data.links.live && !playable && <a href={data.links.live} rel="noopener" class="btn btn-primary">View live</a>}
            {data.links.live && playable && <a href={data.links.live} rel="noopener" class="c-link">View live</a>}
            {data.links.source && <a href={data.links.source} rel="noopener" class="c-link">Source <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>}
            {data.links.writeup && <a href={data.links.writeup} rel="noopener" class="c-link">External write-up <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>}
          </div>
        )}

        {data.metrics.length > 0 && (
          <dl class="metrics">
            {data.metrics.map((m) => (
              <>
                <dt class="mono">{m.label}</dt>
                <dd>{m.value}</dd>
              </>
            ))}
          </dl>
        )}

        {data.cover && (
          <figure class="cover">
            <Cover cover={data.cover} alt={data.coverAlt ?? ''} widths={[640, 1024, 1400]} sizes="(max-width: 1024px) 100vw, 41rem" />
            {data.coverAlt && <figcaption>{data.coverAlt}</figcaption>}
          </figure>
        )}
        <!-- A project without cover art gets nothing here. A generated
             gradient standing in for a screenshot is what makes a portfolio
             look padded. -->

        <Console slot="code" id="project" endpoint="project" params={{ id: project.id }} options={{ id: ids }} body={full} />
      </Row>

      <!-- THE CONTRACT: rendered identically on every project, so a reader
           comparing two projects finds the same answers in the same place. -->
      <Row id="contract">
        <h2>The problem</h2>
        <p class="t">{data.problem}</p>
        <h2 class="mt">What was unique</h2>
        <p class="t">{data.unique}</p>
        {data.aiNote && (
          <>
            <h2 class="mt">Where AI fit in</h2>
            <p class="t">{data.aiNote}</p>
          </>
        )}
        <Console
          slot="code"
          id="contract"
          endpoint="project"
          params={{ id: project.id, fields: contractFields.join(',') }}
          options={{ id: ids }}
          body={contract}
        />
      </Row>

      <!-- The parts of the system, before the long read rather than after it.
           Someone who came for "how does the repricing work" should not have
           to finish 1,300 words about the whole ERP to find out that there is
           a dedicated write-up for it. -->
      {children.length > 0 && (
        <Row id="inside">
          <h2>Inside it</h2>
          <ul class="subs">
            {children.map((child) => (
              <li>
                <a href={`/projects/${child.id}`}>{child.data.title}</a>
                <p>
                  <span class="only-plain">{child.data.plainBlurb ?? child.data.blurb}</span>
                  <span class="only-eng">{child.data.blurb}</span>
                </p>
              </li>
            ))}
          </ul>
          <Console
            slot="code"
            id="inside"
            endpoint="project"
            params={{ id: project.id, fields: 'subsystems' }}
            options={{ id: ids }}
            body={inside}
          />
        </Row>
      )}

      <!-- The long read. Beside it the dark column carries the write-up's own
           map — its sections, as anchors — so a reader can jump the way they
           would in a reference. -->
      <Row id="writeup">
        <div class="prose-portfolio">
          <Content components={components} />
        </div>
        <Fragment slot="code">
          {sections.length > 0 && (
            <nav class="panel" aria-label="In this write-up">
              <div class="bar mono"><span><b>In this write-up</b></span><span class="src">{sections.length} sections</span></div>
              <ol class="toc">
                {sections.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
        </Fragment>
      </Row>

      <Row id="learned">
        <h2>What I learned</h2>
        <ol class="learned">
          {data.learned.map((lesson) => <li>{lesson}</li>)}
        </ol>
        {(prev || next) && (
          <nav class="prevnext" aria-label="More projects">
            {prev ? <a href={`/projects/${prev.id}`}>← {prev.data.title}</a> : <span />}
            {next && <a href={`/projects/${next.id}`}>{next.data.title} →</a>}
          </nav>
        )}
        <Console
          slot="code"
          id="learned"
          endpoint="project"
          params={{ id: project.id, fields: 'learned' }}
          options={{ id: ids }}
          body={learned}
        />
      </Row>
    </article>
  </div>
</Base>

<style>
  .toc { padding: 0.5rem 0; }
  .toc li { border-top: 1px solid var(--code-line); }
  .toc li:first-child { border-top: 0; }
  .toc a {
    display: block;
    padding: 0.55rem 0.9rem;
    font-size: 0.8125rem;
    color: var(--code-ink);
    text-decoration: none;
  }
  .toc a:hover { color: var(--syn-key); background: rgba(255, 255, 255, 0.03); }
  .toc li[aria-current='true'] a { color: var(--syn-key); box-shadow: inset 2px 0 0 var(--syn-key); }
</style>

<script>
  // The write-up's own map lights the section in view, and lists only the
  // sections the current register shows: a heading inside the other
  // register's block is display:none, and a link to it would go nowhere.
  document.addEventListener('astro:page-load', () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')];
    if (links.length === 0) return;
    const pairs = links
      .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.getAttribute('href')!.slice(1))) }))
      .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => !!x.el);
    const prune = () => {
      let shown = 0;
      pairs.forEach(({ a, el }) => {
        const visible = el.getClientRects().length > 0;
        a.parentElement!.hidden = !visible;
        if (visible) shown++;
      });
      const panel = links[0]?.closest<HTMLElement>('.panel');
      if (panel) panel.hidden = shown === 0;
      const count = panel?.querySelector<HTMLElement>('.bar .src');
      if (count) count.textContent = `${shown} ${shown === 1 ? 'section' : 'sections'}`;
    };
    prune();
    const mo = new MutationObserver(prune);
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });
    document.addEventListener('astro:before-swap', () => mo.disconnect(), { once: true });
    if (!('IntersectionObserver' in window)) return;
    const targets = pairs.map((x) => x.el);
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!hit) return;
        links.forEach((a) => a.parentElement!.setAttribute('aria-current', String(a.getAttribute('href') === `#${(hit.target as HTMLElement).id}`)));
      },
      { rootMargin: '-10% 0px -75% 0px', threshold: 0 },
    );
    targets.forEach((t) => io.observe(t));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
