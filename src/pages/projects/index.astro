---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import WorkRow from '../../components/ui/WorkRow.astro';
import { getProjects, getChildren } from '../../lib/content';

const projects = await getProjects();
// Subsystems are listed once, under their parent, instead of competing with it
// in the grid. See `parent` in src/content.config.ts.
const subsystems = await getChildren('mhlhub');
const stacks = [...new Set(projects.flatMap((p) => p.data.stack))].sort();
---
<Base title="Work" description="Everything I've built and written up: the problem, what was non-obvious, and what came out of it.">
  <section>
    <div class="mx-auto max-w-(--container-wide) px-4 pb-10 pt-12 sm:px-6 sm:pt-16">
      <p class="eyebrow reveal reveal-load">Work</p>
      <h1 class="reveal reveal-load mt-4 text-4xl font-extrabold tracking-tight text-ink sm:text-6xl" style="--reveal-delay: 60ms">
        Projects, written up{' '}<span class="text-gradient">properly.</span>
      </h1>
      <p class="reveal reveal-load mt-5 max-w-(--container-reading) text-lg text-ink-muted" style="--reveal-delay: 120ms">
        Each one says what the problem was, what was non-obvious about the approach, and what
        came out of it, in the same places every time, so you can compare them.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-(--container-wide) px-4 sm:px-6">
    {stacks.length > 0 && (
      <div class="reveal flex flex-wrap gap-2" role="group" aria-label="Filter by technology">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="rounded-lg border border-accent bg-accent px-3 py-1.5 text-sm font-medium text-accent-ink"
        >
          All
        </button>
        {stacks.map((tech) => (
          <button
            type="button"
            data-filter={tech}
            aria-pressed="false"
            class="rounded-lg border border-border px-3 py-1.5 text-sm text-ink-muted transition-colors hover:border-border-strong hover:text-ink"
          >
            {tech}
          </button>
        ))}
      </div>
    )}

    <div id="project-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <div data-stack={project.data.stack.join('|')}>
          <ProjectCard project={project} delay={(i % 3) * 70} />
        </div>
      ))}
    </div>

    <p id="empty-state" class="hidden py-16 text-center text-ink-muted">
      Nothing matches that filter.
    </p>

    {subsystems.length > 0 && (
      <section class="mt-20 border-t border-border pt-10">
        <p class="eyebrow reveal">Inside MHLHUB</p>
        <p class="reveal mt-3 max-w-(--container-reading) text-ink-muted">
          Three parts of the ERP with write-ups of their own. They are not separate
          projects — they are the pieces that made the whole thing work.
        </p>
        <div class="mt-8 border-t border-border">
          {subsystems.map((project, i) => <WorkRow project={project} delay={i * 50} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    // Vanilla filtering — no framework runtime on the index page.
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('#project-grid > [data-stack]');
    const empty = document.getElementById('empty-state');

    const ACTIVE = ['border-accent', 'bg-accent', 'text-accent-ink', 'font-medium'];
    const IDLE = ['border-border', 'text-ink-muted'];

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;

        buttons.forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-pressed', String(on));
          b.classList.remove(...(on ? IDLE : ACTIVE));
          b.classList.add(...(on ? ACTIVE : IDLE));
        });

        let shown = 0;
        cards.forEach((card) => {
          const match = filter === 'all' || (card.dataset.stack ?? '').split('|').includes(filter);
          card.hidden = !match;
          if (match) shown++;
        });
        empty?.classList.toggle('hidden', shown > 0);
      });
    });
  });
</script>
