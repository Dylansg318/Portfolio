---
import Base from '../../layouts/Base.astro';
import Rail from '../../components/ref/Rail.astro';
import Row from '../../components/ref/Row.astro';
import Crumb from '../../components/ref/Crumb.astro';
import Console from '../../components/ref/Console.astro';
import Cover from '../../components/ui/Cover.astro';
import { getProjects, getChildren, getAllProjects, statusLabel } from '../../lib/content';
import { CATEGORIES, categoryLabel } from '../../lib/categories';
import { workList, projectById } from '../../lib/api';

const projects = await getProjects();
// Subsystems are listed once, under their parent, instead of competing with it
// in the list. See `parent` in src/content.config.ts.
const subsystems = await getChildren('internal-erp');
// The tabs are the categories with something filed under them, in the order
// src/lib/categories.ts declares — not the stack, which grew one chip per
// library until the row was a keyword cloud. An empty shelf gets no tab.
const categories = CATEGORIES.filter((c) => projects.some((p) => p.data.category === c));
const ids = (await getAllProjects()).map((p) => ({ value: p.id, label: p.id }));

const work = await workList();
const inside = await projectById('internal-erp', ['subsystems']);
---
<Base title="Work" description="Everything I've built and written up: the problem, what was non-obvious, and what came out of it.">
  <div class="ref">
    <Rail current="work" />
    <div class="ref-main">
      <Row id="work">
        <Crumb method="GET" path="/api/work" />
        <h1 class="page">Projects, written up properly.</h1>
        <p class="lead">
          Each one says what the problem was, what was non-obvious about the approach, and what
          came out of it, in the same places every time, so you can compare them.
        </p>

        {categories.length > 1 && (
          <nav class="cats" aria-label="Filter by kind of project">
            <ul role="group">
              <li><button type="button" data-filter="all" aria-pressed="true">All</button></li>
              {categories.map((category) => (
                <li><button type="button" data-filter={category} aria-pressed="false">{categoryLabel[category]}</button></li>
              ))}
            </ul>
          </nav>
        )}

        <div class="items" id="work-list">
          {projects.map((project) => {
            const { data } = project;
            return (
              <article class:list={['item', data.cover && 'has-pic']} data-category={data.category}>
                <div>
                  <h3><a href={`/projects/${project.id}`}>{data.title}</a></h3>
                  <p class="status">
                    {statusLabel[data.status]} · {data.date.getFullYear()}{data.role && ` · ${data.role}`}
                  </p>
                  <p class="t">
                    <span class="only-plain">{data.plainBlurb ?? data.blurb}</span>
                    <span class="only-eng">{data.blurb}</span>
                  </p>
                  <p class="more"><a href={`/projects/${project.id}`} class="c-link">Read the project <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></p>
                </div>
                {data.cover && (
                  <div class:list={['pic', data.cover.width === data.cover.height && 'sq']}>
                    <Cover cover={data.cover} alt={data.coverAlt ?? ''} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 208px" />
                  </div>
                )}
              </article>
            );
          })}
        </div>
        <p id="work-empty" class="t" hidden>Nothing filed under this category yet.</p>

        <Console slot="code" id="work" endpoint="work" body={work} />
      </Row>

      {subsystems.length > 0 && (
        <Row id="inside">
          <h2>Inside the ERP</h2>
          <p class="t">
            Six parts of the ERP with write-ups of their own. They are not separate projects —
            they are the pieces that made the whole thing work.
          </p>
          <ul class="subs">
            {subsystems.map((s) => (
              <li>
                <a href={`/projects/${s.id}`}>{s.data.title}</a>
                <p>
                  <span class="only-plain">{s.data.plainBlurb ?? s.data.blurb}</span>
                  <span class="only-eng">{s.data.blurb}</span>
                </p>
              </li>
            ))}
          </ul>
          <Console
            slot="code"
            id="inside"
            endpoint="project"
            params={{ id: 'internal-erp', fields: 'subsystems' }}
            options={{ id: ids }}
            body={inside}
          />
        </Row>
      )}
    </div>
  </div>
</Base>

<script>
  // The tabs, the ?category= in the address, and the console's `category`
  // parameter are one control in three places. Any of them changing moves
  // the other two. Vanilla — no framework runtime on the index page.
  document.addEventListener('astro:page-load', () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    if (buttons.length === 0) return;
    const cards = [...document.querySelectorAll<HTMLElement>('#work-list > [data-category]')];
    const empty = document.getElementById('work-empty');
    const consoleEl = document.querySelector<HTMLElement>('.cx[data-key="work"]');
    const known = new Set(buttons.map((b) => b.dataset.filter!));

    const apply = (filter: string, { push = true, tellConsole = true } = {}) => {
      const f = known.has(filter) ? filter : 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      let shown = 0;
      cards.forEach((card) => {
        const match = f === 'all' || card.dataset.category === f;
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      if (push) {
        const url = new URL(location.href);
        if (f === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', f);
        history.replaceState(null, '', url);
      }
      if (tellConsole) consoleEl?.dispatchEvent(new CustomEvent('console:set', { detail: { category: f === 'all' ? '' : f } }));
    };

    buttons.forEach((btn) => btn.addEventListener('click', () => apply(btn.dataset.filter!)));

    // A Send on the /api/work console with a category filters the list.
    const onSent = (e: Event) => {
      const d = (e as CustomEvent<{ key: string; params: Record<string, string> }>).detail;
      if (d?.key === 'work') apply(d.params.category || 'all', { tellConsole: false });
    };
    document.addEventListener('console:sent', onSent);
    document.addEventListener('astro:before-swap', () => document.removeEventListener('console:sent', onSent), { once: true });

    // Deferred a tick so the console has mounted its listeners first.
    const initial = new URLSearchParams(location.search).get('category');
    if (initial) setTimeout(() => apply(initial, { push: false }), 0);
  });
</script>
