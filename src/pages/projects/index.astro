---
import Base from '../../layouts/Base.astro';
import SideMenu from '../../components/ref/SideMenu.astro';
import Row from '../../components/ref/Row.astro';
import Crumb from '../../components/ref/Crumb.astro';
import Console from '../../components/ref/Console.astro';
import Cover from '../../components/ui/Cover.astro';
import { getSection, hrefOf, statusLabel } from '../../lib/content';
import { categoryLabel } from '../../lib/categories';
import { PROJECT_CATEGORIES, projectList } from '../../lib/api';

// Everything that isn't work; the ERP and the AI sessions are on /work.
const projects = await getSection('projects');
// The shelves are the categories with something filed under them, in the
// order src/lib/categories.ts declares — not the stack, which grew one chip
// per library until the row was a keyword cloud. Each is a heading over its
// own projects and an entry in the side menu; an empty shelf gets neither.
const shelves = PROJECT_CATEGORIES.map((category) => ({
  category,
  projects: projects.filter((p) => p.data.category === category),
})).filter((s) => s.projects.length > 0);

const list = await projectList();
---
<Base title="Projects" description="What I've built on my own time, written up: the problem, what was non-obvious, and what came out of it.">
  <div class="ref">
    <SideMenu section="projects" current="/projects" />
    <div class="ref-main">
      <Row id="projects">
        <Crumb method="GET" path="/api/projects" />
        <h1 class="page">Projects, written up properly.</h1>
        <p class="lead">
          Each one says what the problem was, what was non-obvious about the approach, and what
          came out of it, in the same places every time, so you can compare them.
        </p>

        {shelves.map(({ category, projects }) => (
          <section class="shelf" data-shelf={category}>
            <h2 class="mt">{categoryLabel[category]}</h2>
            <div class="items">
              {projects.map((project) => {
                const { data } = project;
                return (
                  <article class:list={['item', data.cover && 'has-pic']}>
                    <div>
                      <h3><a href={hrefOf(project)}>{data.title}</a></h3>
                      <p class="status">
                        {statusLabel[data.status]} · {data.date.getFullYear()}{data.role && ` · ${data.role}`}
                      </p>
                      <p class="t">
                        <span class="only-plain">{data.plainBlurb ?? data.blurb}</span>
                        <span class="only-eng">{data.blurb}</span>
                      </p>
                      <p class="more"><a href={hrefOf(project)} class="c-link">Read the project <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></p>
                    </div>
                    {data.cover && (
                      <div class:list={['pic', data.cover.width === data.cover.height && 'sq']}>
                        <Cover cover={data.cover} alt={data.coverAlt ?? ''} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 208px" />
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))}

        <Console slot="code" id="projects" endpoint="projects" body={list} />
      </Row>

    </div>
  </div>
</Base>

<script>
  // `category` in three places — the address, the console's parameter, and
  // the list — kept as one, the way `since` is on /about. The side menu's
  // shelf links set it and it marks the one showing. Vanilla — no framework
  // runtime on the index page.
  document.addEventListener('astro:page-load', () => {
    const shelves = [...document.querySelectorAll<HTMLElement>('[data-shelf]')];
    if (shelves.length === 0) return;
    const side = [...document.querySelectorAll<HTMLAnchorElement>('.side a[href^="/projects"]:not([href^="/projects/"])')];
    const consoleEl = document.querySelector<HTMLElement>('.cx[data-key="projects"]');
    const known = new Set(shelves.map((s) => s.dataset.shelf!));

    const apply = (filter: string, { push = true, tellConsole = true } = {}) => {
      const f = known.has(filter) ? filter : 'all';
      shelves.forEach((s) => (s.hidden = f !== 'all' && s.dataset.shelf !== f));
      const mark = f === 'all' ? '/projects' : `/projects?category=${f}`;
      side.forEach((a) => (a.getAttribute('href') === mark ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
      if (push) {
        const url = new URL(location.href);
        if (f === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', f);
        history.replaceState(null, '', url);
      }
      if (tellConsole) consoleEl?.dispatchEvent(new CustomEvent('console:set', { detail: { category: f === 'all' ? '' : f } }));
    };

    // A Send on the /api/projects console with a category filters the list.
    const onSent = (e: Event) => {
      const d = (e as CustomEvent<{ key: string; params: Record<string, string> }>).detail;
      if (d?.key === 'projects') apply(d.params.category || 'all', { tellConsole: false });
    };
    document.addEventListener('console:sent', onSent);
    document.addEventListener('astro:before-swap', () => document.removeEventListener('console:sent', onSent), { once: true });

    // Deferred a tick so the console has mounted its listeners first.
    const initial = new URLSearchParams(location.search).get('category');
    if (initial) setTimeout(() => apply(initial, { push: false }), 0);
  });
</script>
