---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { getProjects } from '../lib/content';

// The three projects a recruiter should see on a one-page résumé.
const projects = (await getProjects()).filter((p) => p.id !== 'portfolio-site').slice(0, 3);
---
<Base title="Résumé" description={`${site.name} — résumé. ${site.role}, ${site.location}.`}>
  <div class="print-page mx-auto max-w-(--container-reading) px-4 py-12 sm:px-6 sm:py-16">
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-surface p-4 text-sm">
      <p class="text-ink-muted">This page prints cleanly to one or two pages.</p>
      <div class="flex gap-2">
        <button type="button" id="print-btn" class="btn btn-primary text-sm">Print / Save as PDF</button>
        <a href="/contact" class="btn btn-ghost text-sm">Contact</a>
      </div>
    </div>

    <header class="border-b border-border pb-6">
      <h1 class="text-4xl font-extrabold tracking-tight text-ink">{site.name}</h1>
      <p class="mt-1 text-lg text-ink-muted">{site.role}</p>
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-faint">
        <span>{site.location}</span>
        <a class="text-accent hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="text-accent hover:underline" href={site.links.github} rel="me noopener">github.com/Dylansg318</a>
        {site.links.linkedin && <a class="text-accent hover:underline" href={site.links.linkedin} rel="me noopener">LinkedIn</a>}
        <a class="text-accent hover:underline" href="/">portfolio.dylansg0318.workers.dev</a>
      </p>
    </header>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-ink-faint">Summary</h2>
      <p class="mt-3 leading-relaxed text-ink">
        Software engineer who built and runs the ERP a six-channel dental distributor
        operates on: order intake, inventory, repricing, shipping, customer service and
        QuickBooks integration in one TypeScript/PostgreSQL codebase with ~180 scheduled
        jobs. Daily orders roughly doubled (≈270 → ≈520) on a 32,000-product catalog
        during my tenure. Testing background (SDET), strong on integrations and on the
        kind of data correctness that only shows up weeks later in a reconcile.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-ink-faint">Experience</h2>
      <ol class="mt-3 space-y-6">
        {site.experience.map((job) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-ink">
                {job.title} <span class="font-normal text-ink-muted">· {job.org}, {job.place}</span>
              </h3>
              <p class="text-sm tabular-nums text-ink-faint">{job.start} – {job.end}</p>
            </div>
            <ul class="mt-2 list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed text-ink">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-ink-faint">Selected projects</h2>
      <ul class="mt-3 space-y-3">
        {projects.map((p) => (
          <li>
            <a href={`/projects/${p.id}`} class="font-semibold text-ink hover:text-accent">{p.data.title}</a>
            <span class="text-ink-faint"> · {p.data.stack.slice(0, 4).join(', ')}</span>
            <p class="text-[0.95rem] leading-relaxed text-ink-muted">{p.data.blurb}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-ink-faint">Skills</h2>
      <dl class="mt-3 grid gap-x-6 gap-y-2 text-[0.95rem] sm:grid-cols-[auto_1fr]">
        {site.skills.map((row) => (
          <>
            <dt class="font-semibold text-ink">{row.group}</dt>
            <dd class="text-ink-muted">{row.items.join(', ')}</dd>
          </>
        ))}
      </dl>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-ink-faint">Education</h2>
      <ul class="mt-3 space-y-3">
        {site.education.map((e) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <p class="font-semibold text-ink">{e.title} <span class="font-normal text-ink-muted">· {e.org}, {e.place}</span></p>
              <p class="text-sm text-ink-faint">{e.when}</p>
            </div>
            <p class="text-[0.95rem] text-ink-muted">{e.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-ink-faint">Certifications</h2>
      <ul class="mt-3 space-y-1 text-[0.95rem]">
        {site.certifications.map((c) => (
          <li class="text-ink">{c.name} <span class="text-ink-faint">· {c.issuer} · verification {c.id}</span></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>
