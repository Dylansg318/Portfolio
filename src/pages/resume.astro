---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

/** The résumé. One column, standard section names, contact details in the
 *  body — the shape every applicant-tracking parser reads correctly. The
 *  same markup prints to the one-page PDF at public/resume.pdf
 *  (`npm run resume:pdf`), so the page and the file can't disagree.
 *
 *  Things deliberately NOT here: the phone number and street address (this
 *  page and the PDF are public), and volume metrics like lines of code or
 *  endpoint counts — they say how big, not how good, and a reviewer who
 *  knows that discounts everything around them. */

// `site` is `as const`, so an empty links entry narrows to `never` inside a
// truthy guard. Widening once here keeps the markup free of casts.
const githubUrl: string = site.links.github;
const linkedinUrl: string = site.links.linkedin;
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const siteHost = bare(Astro.site?.toString() ?? '');
// Print shows every link as an address a reader can type; screen shows a label.
const abs = (href: string) => (href.startsWith('/') ? `${siteHost}${href}` : bare(href));
---
<Base title="Resume" description={`${site.name} — ${site.role}, ${site.location}. One-page résumé, also as PDF.`}>
  <div class="resume mx-auto max-w-(--container-reading) px-4 py-10 sm:px-6 sm:py-14">
    <!-- Utility row, kept thin: the name is the first thing a reader should
         see, not a banner about printing. -->
    <div class="no-print mb-6 flex flex-wrap items-center justify-between gap-3 text-sm">
      <p class="text-ink-muted">One page. Also as a PDF for your tracking system.</p>
      <div class="flex gap-2">
        <a href={site.resumePdf} class="btn btn-primary text-sm" download="Dylan-San-Gabriel-Resume.pdf">Download PDF</a>
        <button type="button" id="print-btn" class="btn btn-ghost text-sm">Print</button>
      </div>
    </div>

    <header class="border-b border-border pb-5">
      <h1 class="text-4xl font-extrabold tracking-tight text-ink">{site.name}</h1>
      <p class="mt-1 text-lg text-ink-muted">{site.role}</p>
      <p class="contact mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-faint">
        <span>{site.location}</span>
        <a class="text-accent hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="text-accent hover:underline" href={siteHost ? `https://${siteHost}` : '/'}>{siteHost}</a>
        {githubUrl && <a class="text-accent hover:underline" href={githubUrl} rel="me noopener">{bare(githubUrl)}</a>}
        {linkedinUrl && <a class="text-accent hover:underline" href={linkedinUrl} rel="me noopener">{bare(linkedinUrl)}</a>}
      </p>
    </header>

    <section class="mt-7">
      <h2 class="section-title">Summary</h2>
      <p class="mt-2 leading-relaxed text-ink">{site.resumeSummary}</p>
    </section>

    <section class="mt-7">
      <h2 class="section-title">Experience</h2>
      <ol class="mt-2 space-y-5">
        {site.experience.map((job) => (
          <li class="job">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-ink">
                {job.title} <span class="font-normal text-ink-muted">· {job.org}, {job.place}</span>
              </h3>
              <p class="text-sm tabular-nums text-ink-faint">{job.start} – {job.end}</p>
            </div>
            <ul class="mt-1.5 list-disc space-y-1 pl-5 text-[0.95rem] leading-relaxed text-ink">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-7">
      <h2 class="section-title">Projects</h2>
      <ul class="mt-2 space-y-2.5">
        {site.resumeProjects.map((p) => (
          <li>
            <a href={p.href} class="font-semibold text-ink hover:text-accent" rel={p.href.startsWith('/') ? undefined : 'noopener'}>
              {p.title}
            </a>
            <span class="text-ink-faint"> · {p.stack}</span>
            <span class="print-url text-ink-faint"> · {abs(p.href)}</span>
            <p class="text-[0.95rem] leading-relaxed text-ink-muted">{p.blurb}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-7">
      <h2 class="section-title">Skills</h2>
      <ul class="mt-2 space-y-1 text-[0.95rem] leading-relaxed">
        {site.skills.map((row) => (
          <li>
            <span class="font-semibold text-ink">{row.group}:</span>{' '}
            <span class="text-ink-muted">{row.items.join(', ')}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-7">
      <h2 class="section-title">Education &amp; Certifications</h2>
      <ul class="mt-2 space-y-2.5">
        {site.education.map((e) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <p class="font-semibold text-ink">{e.title} <span class="font-normal text-ink-muted">· {e.org}, {e.place}</span></p>
              <p class="text-sm text-ink-faint">{e.when}</p>
            </div>
            <p class="text-[0.95rem] leading-relaxed text-ink-muted">{e.detail}</p>
          </li>
        ))}
      </ul>
      <p class="mt-2.5 text-[0.95rem] text-ink">
        <span class="font-semibold">Certifications:</span>{' '}
        {site.certifications.map((c, i) => (
          <>
            {i > 0 && <span class="text-ink-faint"> · </span>}
            {c.name} <span class="text-ink-faint">({c.issuer} {c.id})</span>
          </>
        ))}
      </p>
    </section>
  </div>
</Base>

<style>
  .section-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  /* Only the printed page needs the address spelled out. */
  .print-url { display: none; }
</style>

<script>
  // Re-run on every View Transitions navigation: a bundled module
  // executes once, so top-level setup would go dead after the first
  // soft navigation. astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', () => {
    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  });
</script>
