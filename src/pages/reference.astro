---
import Base from '../layouts/Base.astro';
import Rail from '../components/ref/Rail.astro';
import Row from '../components/ref/Row.astro';
import Crumb from '../components/ref/Crumb.astro';
import Console from '../components/ref/Console.astro';
import Method from '../components/ref/Method.astro';
import { ENDPOINTS } from '../lib/endpoints';
import { indexRecord } from '../lib/api';

/**
 * The index as a page: one row, GET /api. The rail's Index entry used to open
 * the JSON itself, which made it the one link in the navigation that left the
 * site — fine in a browser that prettifies JSON, a wall of text in the rest,
 * and no way back for a reader who did not know what they had clicked.
 *
 * The list on the left and the response on the right are rendered from the
 * same `ENDPOINTS`, so the prose cannot name an endpoint the console does not
 * carry. Each entry links to the page whose row it is.
 */
const index = indexRecord();
const reads = ENDPOINTS.filter((e) => e.method === 'GET').length;
const writes = ENDPOINTS.length - reads;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const count = (n: number) => words[n] ?? String(n);
const cap = (w: string) => w.charAt(0).toUpperCase() + w.slice(1);
---
<Base title="Index" description="Every endpoint of this site's API — what it answers, its parameters, and the page that shows the same thing in words.">
  <div class="ref">
    <Rail current="index" />
    <div class="ref-main">
      <Row id="index">
        <Crumb method="GET" path="/api" />
        <h1 class="page">Everything you can ask for.</h1>
        <p class="lead">
          <span class="only-plain">
            Anything on this site you can also get as data, if you'd rather pull it into a
            program than read it. This is the list of what you can ask for, what you get back,
            and which page shows the same thing in words.
          </span>
          <span class="only-eng">
            {cap(count(ENDPOINTS.length))} endpoints, {count(reads)} reads and {count(writes)}{' '}
            write. Each one is also a page here, built from the same data, so the page and the
            answer can't disagree. Below is what each one takes and what it gives back.
          </span>
        </p>
        <p class="t">
          <span class="only-plain">
            Every answer comes with the page it came from, so you can always go check it against
            what's written there.
          </span>
          <span class="only-eng">
            Add <code class="mono">?fields=a,b</code> to any GET if you only want part of the
            record; <code class="mono">page</code> comes back either way. If something's wrong it
            says so: a bad parameter is a 400 that lists what's allowed, an id that doesn't exist
            is a 404 with a hint, the wrong method is a 405. A 200 gets cached for five minutes,
            nothing else does.
          </span>
        </p>

        <ol class="eps">
          {ENDPOINTS.map((ep) => (
            <li>
              <p class="crumb mono"><Method method={ep.method} /> <b>{ep.path}</b></p>
              <h3>
                {ep.key === 'index' ? (
                  <span>{ep.page.label} <span class="quiet">· this page</span></span>
                ) : (
                  <a href={ep.page.href}>{ep.page.label}</a>
                )}
              </h3>
              <p>{ep.description}</p>
              <dl>
                {ep.params.map((p) => (
                  <>
                    <dt class="mono">{p.name}</dt>
                    <dd>
                      {p.description}
                      {p.options && p.options.some((o) => o.value) && (
                        <span class="mono opts">{p.options.map((o) => o.value).filter(Boolean).join(' · ')}</span>
                      )}
                    </dd>
                  </>
                ))}
                <dt class="mono">source</dt>
                <dd class="mono">{ep.source}</dd>
              </dl>
            </li>
          ))}
        </ol>

        <Console
          slot="code"
          id="index"
          endpoint="index"
          body={index}
          frame="Live: this is the real index, the same list every console on the site is built from. Send runs it again."
        />
      </Row>
    </div>
  </div>
</Base>
