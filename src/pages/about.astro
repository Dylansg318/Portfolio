---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { site } from '../lib/site';

/** The path here, one line per stop. Deliberately short: the résumé carries
 *  the detail, this page only has to make someone want to read it. */
const path = [
  {
    when: '2020 – 24',
    what: 'B.S. Computer Science, George Mason',
    note: 'Paid for it managing a T-Mobile store, then running a restaurant floor.',
  },
  {
    when: '2024',
    what: 'CYDEO SDET bootcamp',
    note: 'Where the testing habits came from. I still write the test before I trust the fix.',
  },
  {
    when: '2025',
    what: 'Hired to fix a pricing spreadsheet',
    note: 'It became a scraper, then a service, then the ERP the company runs on.',
  },
];
---
<Base title="About" description={`About ${site.name} — ${site.tagline}`}>
  <section class="ambient">
    <div class="mx-auto max-w-(--container-wide) px-4 pb-12 pt-16 sm:px-6 sm:pt-24">
      <p class="eyebrow reveal">About</p>
      <h1 class="reveal mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-ink sm:text-6xl" style="--reveal-delay: 60ms">
        I like the problems where the fix has to{' '}
        <span class="text-gradient">survive the people using it.</span>
      </h1>
    </div>
  </section>

  <div class="mx-auto max-w-(--container-wide) px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-12">
        <!-- Short and specific. Recruiters and their screening tools both parse
             this, and one concrete number beats three adjectives. -->
        <section class="reveal">
          <h2 class="font-display text-2xl font-bold text-ink">The short version</h2>
          <p class="mt-4 max-w-(--container-reading) text-lg leading-relaxed text-ink-muted">
            I'm the engineer at RMH3 Dental Supply. I designed, built and run{' '}
            <a class="text-accent hover:underline" href="/projects/mhlhub">MHLHUB</a> — the
            in-house ERP that replaced off-the-shelf software, a stack of spreadsheets and
            an inbox somebody sorted by hand. Six sales channels, 32,000 products, orders
            roughly doubled while I've been here without adding anyone to operations.
          </p>
          <p class="mt-4 max-w-(--container-reading) text-lg leading-relaxed text-ink-muted">
            Almost everything I've built started as something a person was doing by hand.
            Those are the problems I like — where being subtly wrong costs more than being
            obviously broken.
          </p>
        </section>

        <!-- How I got here -->
        <section>
          <h2 class="reveal font-display text-2xl font-bold text-ink">How I got here</h2>
          <ol class="mt-5 space-y-4">
            {path.map((stop, i) => (
              <li class="tile reveal flex flex-col gap-1 p-5 sm:flex-row sm:gap-6" style={`--reveal-delay: ${i * 70}ms`}>
                <span class="shrink-0 pt-0.5 font-mono text-sm tabular-nums text-accent sm:w-24">{stop.when}</span>
                <span>
                  <span class="block font-semibold text-ink">{stop.what}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-ink-muted">{stop.note}</span>
                </span>
              </li>
            ))}
          </ol>
        </section>

        <!-- Now / outside -->
        <section class="grid gap-4 sm:grid-cols-2">
          <div class="tile reveal p-6">
            <p class="eyebrow">Right now</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              Running a fleet of AI coding sessions against one codebase without them
              corrupting each other — the hooks and rules that make the dangerous
              operations impossible rather than discouraged.{' '}
              <a class="text-accent hover:underline" href="/projects/agent-fleet">The write-up →</a>
            </p>
          </div>
          <div class="tile reveal p-6" style="--reveal-delay: 70ms">
            <p class="eyebrow">Off the clock</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              Bass and contrabass clarinet through school, four years of marching band.
              Filipino-American — I understand Tagalog better than I speak it. Games with
              friends, 3D printing, and a restaurant I haven't tried yet.
            </p>
          </div>
        </section>
      </div>

      <aside class="space-y-6">
        <div class="tile reveal p-6" style="--reveal-delay: 80ms">
          <p class="eyebrow">Facts</p>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-ink-faint">Based in</dt><dd class="text-right text-ink">{site.location}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-faint">Timezone</dt><dd class="text-right text-ink">{site.timezone}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-faint">Open to</dt><dd class="text-right text-ink">Backend · full-stack · remote or NoVA</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-faint">Email</dt><dd class="text-right"><a class="text-accent hover:underline" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          </dl>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href="/contact" class="btn btn-primary text-sm">Get in touch</a>
            <a href={site.resumeUrl} class="btn btn-ghost text-sm">Résumé</a>
          </div>
        </div>

        <div class="tile reveal p-6" style="--reveal-delay: 140ms">
          <p class="eyebrow">Education</p>
          <ul class="mt-4 space-y-4">
            {site.education.map((e) => (
              <li>
                <p class="font-semibold text-ink">{e.title}</p>
                <p class="text-sm text-ink-muted">{e.org} · {e.when}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink-faint">{e.detail}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="tile reveal p-6" style="--reveal-delay: 200ms">
          <p class="eyebrow">Certifications</p>
          <ul class="mt-4 space-y-2 text-sm">
            {site.certifications.map((c) => (
              <li>
                <span class="text-ink">{c.name}</span>
                <span class="text-ink-faint"> · {c.issuer} · {c.id}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <!-- Skills. The one long list that earns its length — it is scanned, not read. -->
    <section class="mt-20 pb-8">
      <SectionHeading
        eyebrow="Toolkit"
        title="What I work with"
        lead="Ordered by how often I reach for it, not alphabetically."
        link={{ href: '/resume', label: 'Full résumé' }}
      />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {site.skills.map((row, i) => (
          <div class="tile reveal p-5" style={`--reveal-delay: ${i * 50}ms`}>
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">{row.group}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {row.items.map((item) => (
                <li class="rounded-md bg-surface-raised px-2 py-1 text-sm text-ink">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
